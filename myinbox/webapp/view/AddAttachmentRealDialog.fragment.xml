<core:FragmentDefinition xmlns:core="sap.ui.core" controllerName="kupit.flexiblewf.myinbox.controller.AddAttachentRealDialog" xmlns="sap.m" xmlns:form="sap.ui.layout.form" 	xmlns:l="sap.ui.layout" xmlns:u="sap.ui.unified">
    <Dialog horizontalScrolling="true" showHeader="true" state="None" stretch="false" title="Add Attachment" type="Standard" verticalScrolling="true">
        <content>
            <form:Form width="100%" editable="true" visible="true">
                <form:title/>
                <form:formContainers>
                    <form:FormContainer visible="true">
                        <form:formElements>
                            <form:FormElement visible="true">
                                <form:label>
                                    <Label text="Descrizione file" design="Standard" width="100%" required="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
                                </form:label>
                                <form:fields>
                                    <Input value="{/newAttachment/fileDescription}" type="Text" showValueHelp="false" enabled="true" visible="true" width="auto" valueHelpOnly="false" required="false" valueStateText="Invalid entry" maxLength="0"/>
                                </form:fields>
                            </form:FormElement>
                            <form:FormElement visible="true">
                                <form:label>
                                    <Label text="File" design="Standard" width="100%" required="false" textAlign="Begin" textDirection="Inherit" visible="true"/>
                                </form:label>
                                <form:fields>
                                    <l:VerticalLayout>
                                        <u:FileUploader
                                            id="fileUploader"
                                            name="myFileUpload"
                                            uploadUrl="upload/"
                                            change="onFileUploadChange"
                                            tooltip="Upload your file to the local server"
                                            uploadComplete="handleUploadComplete"/>
                                        <!--<Button
                                            text="Upload File"
                                            press="handleUploadPress"/>-->
                                    </l:VerticalLayout>                                
                                </form:fields>
                            </form:FormElement>
                        </form:formElements>
                        <form:title/>
                    </form:FormContainer>
                </form:formContainers>
                <form:layout>
                    <form:ResponsiveGridLayout adjustLabelSpan="false" columnsL="2" labelSpanL="3" columnsM="1" labelSpanM="2" labelSpanS="12"/>
                </form:layout>
            </form:Form>
        </content>
        <beginButton/>
        <buttons>
            <Button text="OK" type="Default" iconFirst="true" width="auto" enabled="true" visible="true" iconDensityAware="false" press="_onOkPress"/>
            <Button text="Cancel" type="Default" iconFirst="true" width="auto" enabled="true" visible="true" iconDensityAware="false" press="_onCancelPress"/>
        </buttons>
        <customHeader/>
        <endButton/>
        <subHeader/>
    </Dialog>
</core:FragmentDefinition>
