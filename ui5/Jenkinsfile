pipeline {

  agent none

  options {
    ansiColor('xterm')
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    skipStagesAfterUnstable()
  }

  environment {
    CF_API   = 'https://api.cf.eu10-004.hana.ondemand.com'
    CF_ORG   = 'Kuwait Petroleum Italia S.p.A.'
    CF_SPACE = 'FlexibleV1'

    GH_ORGANIZATION = 'KPICorporate'
    REPOSITORY_NAME = 'sap-btp-cicd'
    JENKINS_ENV     = 'PROD'

    NEXUS_URL  = 'https://nexus.automation-platform.eu-west-1.aws.q8int.com'
	  NEXUS_REPO = 'sap-btp-raw-dev-hosted'
  }

  /* =========================================================
   * CHECKOUT (GH POD)
   * ========================================================= */
  stages {

    stage('Checkout') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'gh',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('gh') {

          script {

            def repoUrl = "git@github.com:${env.GH_ORGANIZATION}/${env.REPOSITORY_NAME}.git"

            def dkName = (
              "AUT-PLAT-${env.JENKINS_ENV}-DK-${env.REPOSITORY_NAME}"
            ).toUpperCase()

            cloneWithDK(
              [
                repo_url: repoUrl,
                dk       : dkName,
                branch   : 'main'
              ]
            ) {

              dir("${env.REPOSITORY_NAME}") {

                env.COMMIT_HASH_APP = sh(
                  script: "git log -n 1 --format='%h'",
                  returnStdout: true
                ).trim()

                sh '''
                  echo "UI5 repository checked out"
                  git status
                '''
              }
            }

            stash(
              name: 'source',
              includes: '**',
              useDefaultExcludes: false
            )
          }
        }
      }
    }

    /* =========================================================
    * BOOTSTRAP UI5 TAG
    * ========================================================= */

    stage('Bootstrap Tag (one-shot)') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      environment {
        TAG_PREFIX = 'workflow' // ui5 | workflow | cap
        INITIAL_VERSION = '3.0.2'
      }

      steps {

        container('sap-btp') {

          unstash 'source'

          withAwsSecret([
            secret_id: "SM-AUT-PLAT-PROD-SAP-BTP-GH-TOKEN".toUpperCase(),
            type: "keyvalue"
          ]) {

            script {

              def githubToken = env.token

              dir("${env.REPOSITORY_NAME}") {

                sh """
                  set -e

                  git remote set-url origin \
                    https://x-access-token:${githubToken}@github.com/${GH_ORGANIZATION}/${REPOSITORY_NAME}.git

                  git fetch --tags --force

                  TAG="${TAG_PREFIX}-v${INITIAL_VERSION}"

                  echo "Checking bootstrap tag: \$TAG"

                  if git tag | grep -q "^\${TAG_PREFIX}-v"; then
                    echo "Tags already exist → skip bootstrap"
                  else
                    echo "Creating bootstrap tag \$TAG"
                    git tag "\$TAG"
                    git push origin "\$TAG"
                  fi
                """
              }
            }
          }
        }
      }
    }

    /* =========================================================
     * SEMANTIC RELEASE (SAP-BTP POD)
     * ========================================================= */
    stage('Semantic Release') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'source'

          withAwsSecret([
            secret_id: "SM-AUT-PLAT-PROD-SAP-BTP-GH-TOKEN".toUpperCase(),
            type: "keyvalue"
          ]) {

            script {

              def githubToken = env.token

              dir("${env.REPOSITORY_NAME}") {


sh '''
              node -v
              npm -v
            '''

            sh """
              git remote set-url origin \
                https://x-access-token:${githubToken}@github.com/${GH_ORGANIZATION}/${REPOSITORY_NAME}.git
            """

            withEnv([
              "GITHUB_TOKEN=${githubToken}",
              "GH_TOKEN=${githubToken}",
              "GIT_BRANCH=main",
              "BRANCH_NAME=main",
              "CI=true",
              "NO_COLOR=1",
              "FORCE_COLOR=0"
            ]) {

              sh '''
                set -e

                echo "Installing semantic-release..."

                npm install --no-save \
                  semantic-release \
                  @semantic-release/commit-analyzer \
                  @semantic-release/release-notes-generator \
                  @semantic-release/git

                echo "Running semantic-release..."

                npx semantic-release \
                  --branches main \
                  --tag-format 'ui5-v${version}' \
                  --no-ci \
                  --plugins \
                    @semantic-release/commit-analyzer \
                    @semantic-release/release-notes-generator \
                    @semantic-release/git \
                  > semantic.log 2>&1 || true

                cat semantic.log

                if grep -q "no new version is released" semantic.log; then
                  echo "NO_RELEASE=true" > version.env
                  echo "No new release"
                else
                  VERSION=$(grep 'next release version is' semantic.log | grep -Eo '[0-9]+[.][0-9]+[.][0-9]+')

                  if [ -z "$VERSION" ]; then
                    echo "ERROR: Unable to detect version"
                    exit 1
                  fi

                  echo "VERSION=$VERSION" > version.env
                  echo "NO_RELEASE=false" >> version.env
                  echo "Next version: $VERSION"
                fi
              '''
            }
          }
        }
      }

      stash(
        name: 'version',
        includes: "${env.REPOSITORY_NAME}/version.env"
      )
    }
  }
}

    stage('Load Version Info') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'version'

          script {
            def props = readProperties file: "${env.REPOSITORY_NAME}/version.env"

            env.NO_RELEASE = props.NO_RELEASE ?: "false"
            env.VERSION    = props.VERSION ?: ""

            echo "Loaded VERSION = ${env.VERSION}"
            echo "Loaded NO_RELEASE = ${env.NO_RELEASE}"
          }
        }
      }
    } 

    stage('Release Gate') {

      steps {
        script {

          if (env.NO_RELEASE == 'true') {
            echo "No release detected → stopping pipeline"

            currentBuild.result = 'UNSTABLE'
            return
          }

            echo "Release detected → continuing pipeline"
        }
      }
    }

    /* =========================================================
     * UPDATE VERSION FILES (SAP-BTP POD)
     * ========================================================= */
    stage('Update UI5 Version') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'source'
          unstash 'version'

          dir("${env.REPOSITORY_NAME}") {

            sh '''
              set -e
              
              NO_RELEASE=$(grep 'NO_RELEASE=' version.env | cut -d '=' -f2)

              if [ "$NO_RELEASE" = "true" ]; then
                echo "Skipping version update"
              else
                VERSION=$(grep '^VERSION=' version.env | cut -d '=' -f2)

                [ -z "$VERSION" ] && exit 0

                sed -i "s/^version: .*/version: $VERSION/" ui5/mta.yaml

                apk add --no-cache jq || true

                # package.json
                jq --arg v "$VERSION" '.version=$v' \
                  ui5/myinbox/package.json > tmp && mv tmp ui5/myinbox/package.json

                # manifest.json
                jq --arg v "$VERSION" \
                  '.["sap.app"].applicationVersion.version = $v' \
                  ui5/myinbox/webapp/manifest.json > tmp && mv tmp ui5/myinbox/webapp/manifest.json
              fi
            '''
          } 

          stash(
            name: 'updated-source',
            includes: '**',
            useDefaultExcludes: false
          )
        }
      }
    }

    /* =========================================================
     * CLEAN WORKSPACE
     * ========================================================= */
    stage('Clean Workspace') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'updated-source'

          dir("${env.REPOSITORY_NAME}/ui5") {

            sh '''
              set -e

              echo "================================================="
              echo "Clean workspace"
              echo "================================================="

              rm -rf \
                gen \
                resources \
                dist \
                node_modules \
                mta_archives \
                *.mtar
            '''
          }

      stash(
        name: 'clean-source',
        includes: '**',
        useDefaultExcludes: false
      )
    }
  }
} 


    /* =========================================================
     * INSTALL & BUILD UI5
     * ========================================================= */
    stage('Build UI5') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'clean-source'

          dir("${env.REPOSITORY_NAME}/ui5/myinbox") {

            sh '''
              set -e

              echo "================================================="
              echo "Node versions"
              echo "================================================="

              node -v
              npm -v

              echo "================================================="
              echo "Install dependencies"
              echo "================================================="

              npm install

              echo "================================================="
              echo "Build UI5"
              echo "================================================="

              npm run build:cf
            '''
          }

          stash(
            name: 'ui5-built',
            includes: '**',
            useDefaultExcludes: false
          )
        }
      }
    }

    /* =========================================================
     * BUILD MTA
     * ========================================================= */
    stage('Build MTA') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'ui5-built'

          dir("${env.REPOSITORY_NAME}/ui5") {

            sh '''
              set -e

              echo "================================================="
              echo "Tool versions"
              echo "================================================="

              node -v
              npm -v
              mbt --version

              echo "================================================="
              echo "Clean previous MTA build"
              echo "================================================="

              rm -rf gen mta_archives resources

              echo "================================================="
              echo "Build MTAR"
              echo "================================================="

              mbt build -p cf -t mta_archives

              echo "================================================="
              echo "Generated MTAR"
              echo "================================================="

              ls -lah mta_archives
            '''
          }

          stash(
            name: 'mtar',
            includes: "${env.REPOSITORY_NAME}/ui5/mta_archives/*.mtar",
            useDefaultExcludes: false
          )
        }
      }
    }

    /* =========================================================
	 * PUBLISH MTAR TO NEXUS
     * ========================================================= */
	stage('Publish MTAR to Nexus') {

		agent {
			kubernetes(k8sAgent(
			cloud: 'kubernetes',
			podTemplate: 'sap-btp',
			serviceAccount: 'jenkins'
			))
		}

		steps {

			container('sap-btp') {

			unstash 'mtar'
			unstash 'version'
			
			withAwsSecret([
			  secret_id: "SM-AUT-PLAT-PROD-NEXUS-SAP-BTP-CREDENTIALS".toUpperCase(),
			  type: "keyvalue"
			]) {
			
			  script {
				
				def nexusToken = env.token

        withEnv([
						"NEXUS_TOKEN_B64=${nexusToken}"
					]) {

				dir("${env.REPOSITORY_NAME}/ui5") {

					sh '''
						set -e					

					  VERSION=$(grep '^VERSION=' ../version.env | cut -d '=' -f2)

					  MTAR_FILE=$(ls mta_archives/*.mtar | head -n 1)

					  MTAR_NAME=$(basename "$MTAR_FILE")

					  echo "================================================="
					  echo "Upload MTAR to Nexus"
					  echo "================================================="

					  echo "Artifact: $MTAR_NAME"
					  echo "Version : $VERSION"

					  HTTP_CODE=$(curl \
					  -v --insecure \
					  -H "Authorization: Basic ${NEXUS_TOKEN_B64}" \
					  -H "Content-Type: application/octet-stream" \
					  --upload-file "$MTAR_FILE" \
					  -w "%{http_code}" \
					  -o /dev/null \
					  "${NEXUS_URL}/repository/${NEXUS_REPO}/${VERSION}/${MTAR_NAME}")

				    echo "HTTP CODE: $HTTP_CODE"

				    if [ "$HTTP_CODE" != "201" ]; then
					    echo "ERROR: Upload failed"
					    exit 1
				    fi

				    echo "Upload completed successfully"
			    '''
        }  
      }  
	  }
	 }
  }
 }
}

    /* =========================================================
     * DEPLOY CF (SAP-BTP POD)
     * ========================================================= */
    stage('Deploy') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'mtar'

          withAwsSecret([
            secret_id: "SM-AUT-PLAT-PROD-SAP-BTP-DEPLOY-CREDENTIALS".toUpperCase(),
            type: "keyvalue"
          ]) {
            
            script {

              def btpUser = env.username
              def btpPassword = env.password

              withEnv([
                "CF_USER=${btpUser}",
                "CF_PASSWORD=${btpPassword}"
              ]) {

            dir("${env.REPOSITORY_NAME}/ui5") {

              sh '''
                set -e

                echo "================================================="
                echo "CF CLI version"
                echo "================================================="

                cf version

                echo "================================================="
                echo "Install MultiApps plugin"
                echo "================================================="

                cf install-plugin -f multiapps || true

                echo "================================================="
                echo "Locate MTAR"
                echo "================================================="

                MTAR=$(ls mta_archives/*.mtar | head -n 1)

                if [ -z "$MTAR" ]; then
                  echo "MTAR not found!"
                  exit 1
                fi

                echo "MTAR: $MTAR"

                echo "================================================="
                echo "Login to SAP BTP"
                echo "================================================="

                cf login \
                  -a "$CF_API" \
                  -u "$CF_USER" \
                  -p "$CF_PASSWORD" \
                  -o "$CF_ORG" \
                  -s "$CF_SPACE"

                echo "================================================="
                echo "CLEAN MTA"
                echo "================================================="

                cf undeploy kupit-flexiblewf-mta \
                  --delete-services \
                  --delete-service-keys \
                  -f || true

                echo "================================================="
                echo "Deploy MTAR"
                echo "================================================="

                cf deploy "$MTAR" -f --delete-services --delete-service-keys          
              '''
            }
          }
        }
      }
    }
  }
}
    /* =========================================================
     * COMMIT & TAG
     * ========================================================= */
    stage('Commit & Tag') {

  agent {
    kubernetes(k8sAgent(
      cloud: 'kubernetes',
      podTemplate: 'gh',
      serviceAccount: 'jenkins'
    ))
  }

  steps {

    container('gh') {

      unstash 'updated-source'
      unstash 'version'

      withAwsSecret([
        secret_id: "SM-AUT-PLAT-PROD-SAP-BTP-GH-TOKEN".toUpperCase(),
        type: "keyvalue"
      ]) {

        script {

          def githubToken = env.token

          withEnv(["GITHUB_TOKEN=${githubToken}"]) {

          sh '''
            set -e

            NO_RELEASE=$(grep 'NO_RELEASE=' ${WORKSPACE}/${REPOSITORY_NAME}/version.env | cut -d '=' -f2)

            if [ "$NO_RELEASE" = "true" ]; then
              echo "Skipping commit & tag"
              exit 0
            fi

            VERSION=\$(grep 'VERSION=' ${WORKSPACE}/${REPOSITORY_NAME}/version.env | cut -d '=' -f2)

            if [ -z "\$VERSION" ]; then
              echo "ERROR: VERSION is empty"
              exit 1
            fi

            echo "Using VERSION: \$VERSION"

            TARGET_REPO="sap-btp-wflibero2-ui5-cicd"
            TARGET_DIR="/tmp/\$TARGET_REPO"

            echo "Target dir: \$TARGET_DIR"

            git config --global user.email "ci@jenkins"
            git config --global user.name "Jenkins CI"

            echo "Cloning repo..."

            rm -rf "\$TARGET_DIR"

            git clone https://x-access-token:$GITHUB_TOKEN@github.com/KPICorporate/\$TARGET_REPO.git "\$TARGET_DIR"

            if [ ! -d "\$TARGET_DIR/.git" ]; then
              echo "ERROR: clone failed"
              exit 1
            fi

            cd "\$TARGET_DIR"

            echo "Copy files"

            cp -f ${WORKSPACE}/${REPOSITORY_NAME}/ui5/mta.yaml mta.yaml
            cp -f ${WORKSPACE}/${REPOSITORY_NAME}/ui5/myinbox/package.json myinbox/package.json
            cp -f ${WORKSPACE}/${REPOSITORY_NAME}/ui5/myinbox/webapp/manifest.json myinbox/webapp/manifest.json

            git add \
            mta.yaml \
            myinbox/package.json \
            myinbox/webapp/manifest.json


            if git diff --cached --quiet; then
              echo "No changes to commit"
            else
              git commit -m "chore(release): $VERSION [skip ci]"
              git push origin main
            fi

            echo "Creating tag v$VERSION"

            git tag -f "v\$VERSION"

            git push origin main
            git push origin "v$VERSION" --force
          '''
            }
          }
        }
      }
    }
  }
 }
}