<mvc:View xmlns:mvc="sap.ui.core.mvc" controllerName="kupit.flexiblewf.myinbox.controller.WfListMaster" xmlns="sap.m" xmlns:core="sap.ui.core">
    <Page title="{i18n>listHeadMyInbox}" showHeader="true" showFooter="true" showNavButton="false">
        <content>
            <VBox width="100%" justifyContent="Center"> 
            <!--<ToggleButton text="{i18n>listHeadToBeApproved}" type="Default" icon="sap-icon://filter" pressed="{/toBeApproved}" press="onSwitchToApprovedMode" iconFirst="true" width="auto" enabled="true" visible="true" iconDensityAware="false"/>-->
            <MultiComboBox
                id="filterWorkflowStatus"
                selectionFinish="handleSelectionFilterFinish">
                <core:Item key="DRAFT" text="Draft"/>
                <core:Item key="PENDING" text="Your Approvals"/>
                <core:Item key="CLOSED" text="Closed"/>
                <core:Item key="INPROGRESS" text="In progress"/>
            </MultiComboBox>
            <HBox>
            <Button text="{i18n>listHeadCreateWF}" type="Default" icon="sap-icon://add-activity" iconFirst="true" width="auto" enabled="true" visible="true" iconDensityAware="false" press="_onButtonPress"/>
            <Button text="{i18n>listHeadRefresh}" type="Default" icon="sap-icon://refresh" iconFirst="true" width="auto" enabled="true" visible="true" iconDensityAware="false" press="_onRefreshButtonPress"/>
            </HBox>
            <!-- <List id="userTaskList" items="{path:'bpmworkflowruntimeodata>/TaskCollection', templateShareable:true, parameters: {expand: 'CustomAttributeData'}}" mode="SingleSelectMaster" width="100%" headerText="Header" footerText="" backgroundDesign="Solid" showSeparators="All" growing="true" growingThreshold="20" growingScrollToLoad="true" visible="true" itemPress="_onObjectListItemPress"> -->
            </VBox>
            <List id="userTaskList" items="{path:'/MyTaskShown', templateShareable:true, parameters: {expand: 'workflow,workflow/ToApprovers,workflow/ToComments'}}" mode="SingleSelectMaster" width="100%" headerText="Header" footerText="" backgroundDesign="Solid" showSeparators="All" growing="false" growingThreshold="20" growingScrollToLoad="true" visible="true" itemPress="_onObjectListItemPress">
                <infoToolbar/>
                <headerToolbar>
                    <Toolbar enabled="true" visible="true" width="" design="Solid">
                        <content>
                            <SearchField placeholder="Search" showRefreshButton="true" showSearchButton="true" visible="true" width="100%" search="onSearchList"/>

                        </content>
                    </Toolbar>
                </headerToolbar>
                <items>
                    <ObjectListItem intro="{i18n>listID} {WorkflowID}" title="{i18n>listSubject}: {workflow/subject}" number="" numberUnit="" numberState="None" type="Active" selected="false"> 
                    <!-- <ObjectListItem attributes="{bpmworkflowruntimeodata>CustomAttributeData}" intro="{bpmworkflowruntimeodata>InstanceID}" title="{bpmworkflowruntimeodata>TaskTitle}" number="1,000" numberUnit="USD" numberState="None" type="Active" selected="false">-->
                        <attributes>
                            <ObjectAttribute text="{i18n>listCreatedBy}: {username}" active="false" visible="true"/> 
                            <!-- <ObjectAttribute text="{bpmworkflowruntimeodata>Name} {bpmworkflowruntimeodata>Value}" active="false" visible="true"/>-->
                        </attributes>
                        <attributes>
                            <ObjectAttribute text="{i18n>listApprovalLevel}: {level}" active="false" visible="true"/> 
                            <!-- <ObjectAttribute text="{bpmworkflowruntimeodata>Name} {bpmworkflowruntimeodata>Value}" active="false" visible="true"/>-->
                        </attributes>
                        <!--<attributes>
                            <ObjectAttribute text="{i18n>listApprovalNumber}: {numb}" active="false" visible="true"/> -->
                            <!-- <ObjectAttribute text="{bpmworkflowruntimeodata>Name} {bpmworkflowruntimeodata>Value}" active="false" visible="true"/>-->
                        <!--</attributes>-->
                        <attributes>
                            <ObjectAttribute text="{i18n>listWFStatus}: {path:'workflow/status', formatter: '.formatStatusWF'}" active="false" visible="true"/> 
                            <!-- <ObjectAttribute text="{bpmworkflowruntimeodata>Name} {bpmworkflowruntimeodata>Value}" active="false" visible="true"/>-->
                        </attributes>
                        <attributes>
                            <ObjectAttribute text="{i18n>listApprovalStatus}: {workflow/status}" active="false" visible="true"/> 
                            <!-- <ObjectAttribute text="{bpmworkflowruntimeodata>Name} {bpmworkflowruntimeodata>Value}" active="false" visible="true"/>-->
                        </attributes>
                        <!--<firstStatus>
                            <ObjectStatus text="Status 1" state="None" visible="true"/>
                        </firstStatus>
                        <secondStatus>
                            <ObjectStatus text="Status 2" state="None" visible="true"/>
                        </secondStatus>-->
                    </ObjectListItem>
                </items>
            </List>
        </content>
        <footer>
            <OverflowToolbar width="100%" height="46px" design="Auto" enabled="true" visible="true">
                <content>
                    <!--<Button press="testPdf" text="ciao"/>-->
                </content>
            </OverflowToolbar>
        </footer>
        <headerContent/>
    </Page>
</mvc:View>
