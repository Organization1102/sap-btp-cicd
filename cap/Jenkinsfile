pipeline {

  agent none

  options {
    ansiColor('xterm')
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  environment {

    CF_API   = 'https://api.cf.eu10-004.hana.ondemand.com'
    CF_ORG   = 'Kuwait Petroleum Italia S.p.A.'
    CF_SPACE = 'FlexibleV1'

    GH_ORGANIZATION = 'KPICorporate'
    REPOSITORY_NAME = 'sap-btp-cicd'
    JENKINS_ENV     = 'PROD'
  }

  stages {

    /* =========================================================
     * CHECKOUT
     * ========================================================= */
    stage('Checkout') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'gh',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('gh') {

          script {

            def repoUrl =
              "git@github.com:${env.GH_ORGANIZATION}/${env.REPOSITORY_NAME}.git"

            def dkName = (
              "AUT-PLAT-${env.JENKINS_ENV}-DK-${env.REPOSITORY_NAME}"
            ).toUpperCase()

            cloneWithDK(
              [
                repo_url: repoUrl,
                dk       : dkName,
                branch   : 'main'
              ]
            ) {

              dir("${env.REPOSITORY_NAME}") {

                sh '''
                  echo "Repository checked out"
                  git status
                '''
              }
            }

            stash(
              name: 'source',
              includes: '**',
              useDefaultExcludes: false
            )
          }
        }
      }
    }

    /* =========================================================
     * SEMANTIC RELEASE
     * ========================================================= */
    stage('Semantic Release (dry-run)') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'source'

          withAwsSecret([
            secret_id: "SM-AUT-PLAT-PROD-SAP-BTP-GH-TOKEN".toUpperCase(),
            type: "keyvalue"
          ]) {

            script {

              def githubToken = env.token

              dir("${env.REPOSITORY_NAME}") {

                sh """
                  git remote set-url origin \
                    https://x-access-token:${githubToken}@github.com/${GH_ORGANIZATION}/${REPOSITORY_NAME}.git
                """

                withEnv([
                  "GITHUB_TOKEN=${githubToken}",
                  "GH_TOKEN=${githubToken}",
                  "GIT_BRANCH=main",
                  "BRANCH_NAME=main",
                  "CI=true",
                  "NO_COLOR=1",
                  "FORCE_COLOR=0"
                ]) {

                  sh '''
					set -e

					node -v
					npm -v

					echo "Installing semantic-release"

					npm install --no-save \
					  semantic-release \
					  @semantic-release/commit-analyzer \
					  @semantic-release/release-notes-generator \
					  @semantic-release/git

					echo "Running semantic-release dry-run"

					npx semantic-release \
					  --branches main \
					  --dry-run \
                      --no-ci \
					  > semantic.log 2>&1 || true

					cat semantic.log

					VERSION=$(grep -E 'next release version is|The next release version is' semantic.log \
					  | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' \
					  | tail -1)

					[ -z "$VERSION" ] && {
					  echo "Unable to detect semantic version"
					  exit 1
					}

					echo "VERSION=$VERSION" > version.env

					echo "Next version: $VERSION"
				  '''
                }
              }
            }
          }

          stash(
            name: 'version',
            includes: "${env.REPOSITORY_NAME}/version.env"
          )
        }
      }
    }

    /* =========================================================
     * INSTALL
     * ========================================================= */
    stage('Install Dependencies') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'source'

          dir("${env.REPOSITORY_NAME}/cap") {

            sh '''
              set -e

              echo "Root install"
              npm install --legacy-peer-deps

              echo "App install"
              [ -f app/package.json ] && (cd app && npm install) || true

              echo "Srv install"
              [ -f srv/package.json ] && (cd srv && npm install) || true

              echo "DB install"
              [ -f db/package.json ] && (cd db && npm install) || true

              echo "Dedupe"
              npm dedupe || true
            '''
          }

          stash(
            name: 'installed-source',
            includes: '**',
            useDefaultExcludes: false
          )
        }
      }
    }

    /* =========================================================
     * UPDATE VERSION
     * ========================================================= */
    stage('Update Version Files') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'installed-source'
          unstash 'version'

          dir("${env.REPOSITORY_NAME}") {

			sh '''
			  set -e

			  VERSION=$(cat version.env | sed 's/VERSION=//')

			  echo "Updating version to $VERSION"

			  MTA_FILE="cap/mta.yaml"

			  npm version $VERSION --no-git-tag-version

			  if grep -q "^version:" "$MTA_FILE"; then
			    sed -i "s/^version:.*/version: $VERSION/" "$MTA_FILE"
			  else
				echo "version: $VERSION" >> "$MTA_FILE"
			  fi

			  echo "Updated $MTA_FILE"

			  cat "$MTA_FILE"
			'''
}
          }

          stash(
            name: 'updated-source',
            includes: '**',
            useDefaultExcludes: false
          )
        }
      }

    /* =========================================================
     * CLEAN
     * ========================================================= */
    stage('Clean Workspace') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'updated-source'

          dir("${env.REPOSITORY_NAME}/cap") {

            sh '''
              set -e

              rm -rf gen
              rm -rf mta_archives
              rm -rf node_modules
              rm -rf kupit-flexiblewf-cap-* || true
            '''
          }

          stash(
            name: 'clean-source',
            includes: '**',
            useDefaultExcludes: false
          )
        }
      }
    }

    /* =========================================================
     * BUILD MTA
     * ========================================================= */
    stage('Build MTA') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'clean-source'

          dir("${env.REPOSITORY_NAME}/cap") {

            sh '''
              set -e

              node -v
              npm -v
              cds --version
              mbt --version

              rm -rf gen mta_archives

              echo "Building CAP project"

              npx cds build

              echo "Installing production deps"

              cd gen/srv
              npm install --omit=dev

              cd ../../

              echo "Building MTAR"

              mbt build -p cf -t mta_archives

              echo "Generated MTAR"

              ls -lah mta_archives
            '''
          }

          stash(
            name: 'mtar',
            includes: "${env.REPOSITORY_NAME}/cap/mta_archives/*.mtar",
            useDefaultExcludes: false
          )
        }
      }
    }

    /* =========================================================
     * DEPLOY
     * ========================================================= */
    stage('Deploy') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'updated-source'
          unstash 'mtar'

          withCredentials([
            usernamePassword(
              credentialsId: 'sap-btp',
              usernameVariable: 'CF_USER',
              passwordVariable: 'CF_PASSWORD'
            )
          ]) {

            dir("${env.REPOSITORY_NAME}/cap") {

              sh '''
                set -e

                cf version

                cf install-plugin -f multiapps || true

                MTAR=$(ls mta_archives/*.mtar | head -n 1)

                cf login \
                  -a "$CF_API" \
                  -u "$CF_USER" \
                  -p "$CF_PASSWORD" \
                  -o "$CF_ORG" \
                  -s "$CF_SPACE"

                cf deploy "$MTAR" -f
              '''
            }
          }
        }
      }
    }

    /* =========================================================
     * COMMIT & TAG
     * ========================================================= */
    stage('Commit & Tag') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'gh',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('gh') {

          unstash 'updated-source'
          unstash 'version'

          withCredentials([
            usernamePassword(
              credentialsId: 'github-token',
              usernameVariable: 'GIT_USER',
              passwordVariable: 'GIT_TOKEN'
            )
          ]) {

            dir("${env.REPOSITORY_NAME}") {

              sh '''
                set -e

                VERSION=$(cat version.env | sed 's/VERSION=//')

                git config user.email "ci@jenkins"
                git config user.name "Jenkins CI"

                git remote set-url origin \
                  https://${GIT_USER}:${GIT_TOKEN}@github.com/KPICorporate/${REPOSITORY_NAME}.git

                git fetch --all --tags

                git checkout main

                git pull origin main

                git add cap/package.json
                git add cap/package-lock.json
                git add cap/mta.yaml

                git commit \
                  -m "chore(release): ${VERSION} [skip ci]" \
                  || true

                git tag -f "v${VERSION}"

                git push origin main
                git push origin --tags --force
              '''
            }
          }
        }
      }
    }
  }
}
