// ================================================================
// Q8 DevOps CAP Template v3.2 -- Nexus promotion as deploy source
// ================================================================

def deployToEnvironment(String targetEnvironment, String mtarPath) {

    if (!targetEnvironment?.trim()) {
        error("Target environment is empty")
    }

    if (!mtarPath?.trim()) {
        error("MTAR path is empty")
    }

    targetEnvironment = targetEnvironment.trim()
    mtarPath = mtarPath.trim()

    echo "================================================="
    echo "Deploy to ${targetEnvironment.toUpperCase()}"
    echo "================================================="
    
    def config = sh(
        script: """
            yq -r '
                .environment.${targetEnvironment} |
                [
                    .cf.api,
                    .cf.org,
                    .cf.space,
                    .credentials.cf
                ] |
                .[]
            ' '${env.CONFIG_FILE}'
        """,
        returnStdout: true
    ).trim().readLines()

    if (config.size() != 4 || config.any { !it || it == 'null' || it ==~ /<.*>/ }) {
        error("Cloud Foundry configuration is incomplete for environment: ${targetEnvironment}")
    }

    def cfApi         = config[0]
    def cfOrg         = config[1]
    def cfSpace       = config[2]
    def credentialsId = config[3]

    withCredentials([
        usernamePassword(
            credentialsId: credentialsId,
            usernameVariable: 'CF_USER',
            passwordVariable: 'CF_PASSWORD'
        )
    ]) {

        dir(env.PROJECT_DIR) {

            sh """
                set -e

                if [ ! -f "${mtarPath}" ]; then
                    echo "ERROR: MTAR not found: ${mtarPath}"
                    exit 1
                fi

                echo "Artifact: ${mtarPath}"
                echo "Version:  ${env.VERSION}"

                cf api "${cfApi}"
                cf auth "\$CF_USER" "\$CF_PASSWORD"
                cf target -o "${cfOrg}" -s "${cfSpace}"

                cf deploy "${mtarPath}" -f
            """
        }
    }
}

pipeline {
    agent any
    
    options {
        ansiColor('xterm')
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        skipStagesAfterUnstable()
    }

    environment {

        // ========================================================
        // PROJECT
        // ========================================================

        PROJECT_DIR = 'application'
        
		CONFIG_FILE = 'pipeline/config/cap.yaml'
		
		MTA_FILE = 'mta.yaml'
        MTAR_DIR = 'mta_archives'

        // ========================================================
        // GITHUB
        // ========================================================

        GH_ORGANIZATION = 'Organization1102'
        PIPELINE_REPOSITORY = 'sap-btp-cicd'
    }

    stages {
	
		stage('Checkout Pipeline') {

			steps {
	
				withCredentials([
					string(
						credentialsId: 'gh-token-q8',
						variable: 'GITHUB_TOKEN'
					)
				]) {

					sh '''
						set -e

						echo "================================================="
						echo "Checkout Pipeline Repository"
						echo "================================================="

                        echo "Cloning ${PIPELINE_REPOSITORY}@${BRANCH_NAME}"

						git clone \
							--branch "$BRANCH_NAME" \
							"https://x-access-token:${GITHUB_TOKEN}@github.com/${GH_ORGANIZATION}/${PIPELINE_REPOSITORY}.git" \
							pipeline
					'''
				}
			}
		}
	
		stage('Load Configuration') {

            steps {

                sh '''
                    set -e

                    echo "================================================="
                    echo "Load Pipeline Configuration"
                    echo "================================================="

                    if [ ! -f "$CONFIG_FILE" ]; then
                        echo "ERROR: Configuration file not found: $CONFIG_FILE"
                        exit 1
                    fi

                    APPLICATION_REPOSITORY=$(
                        yq -r '.application.repository' "$CONFIG_FILE"
                    )

                    case "$BRANCH_NAME" in

                        main)
                            APPLICATION_BRANCH=$(
                                yq -r '.branchStrategy.main.applicationBranch' "$CONFIG_FILE"
                            )

                            ENVIRONMENT=$(
                                yq -r '.branchStrategy.main.environment' "$CONFIG_FILE"
                            )
                            ;;

                        develop)
                            APPLICATION_BRANCH=$(
                                yq -r '.branchStrategy.develop.applicationBranch' "$CONFIG_FILE"
                            )

                            ENVIRONMENT=$(
                                yq -r '.branchStrategy.develop.environment' "$CONFIG_FILE"
                            )
                            ;;

                        feature/*)
                            APPLICATION_BRANCH=$(
                                yq -r '.branchStrategy."feature/*".applicationBranch' "$CONFIG_FILE"
                            )

                            ENVIRONMENT=$(
                                yq -r '.branchStrategy."feature/*".environment' "$CONFIG_FILE"
                            )
                            ;;

                        *)
                            echo "ERROR: No branch strategy configured for: $BRANCH_NAME"
                            exit 1
                            ;;
                    esac


                    # =====================================================
                    # ENVIRONMENT CONFIGURATION
                    # =====================================================

                    CF_API=$(
                        yq -r ".environment.${ENVIRONMENT}.cf.api" "$CONFIG_FILE"
                    )

                    CF_ORG=$(
                        yq -r ".environment.${ENVIRONMENT}.cf.org" "$CONFIG_FILE"
                    )

                    CF_SPACE=$(
                        yq -r ".environment.${ENVIRONMENT}.cf.space" "$CONFIG_FILE"
                    )

                    CF_CREDENTIALS_ID=$(
                        yq -r ".environment.${ENVIRONMENT}.credentials.cf" "$CONFIG_FILE"
                    )


                    # =====================================================
                    # NEXUS CONFIGURATION
                    # =====================================================

                    NEXUS_URL=$(
                        yq -r ".environment.${ENVIRONMENT}.nexus.url" "$CONFIG_FILE"
                    )

                    NEXUS_REPO=$(
                        yq -r ".environment.${ENVIRONMENT}.nexus.repository" "$CONFIG_FILE"
                    )

                    NEXUS_CREDENTIALS_ID=$(
                        yq -r ".environment.${ENVIRONMENT}.credentials.nexus" "$CONFIG_FILE"
                    )


                    # =====================================================
                    # CONFIGURATION VALIDATION
                    # =====================================================

                    validate_config() {

                        NAME="$1"
                        VALUE="$2"

                        if [ -z "$VALUE" ] || \
                        [ "$VALUE" = "null" ] || \
                        echo "$VALUE" | grep -q '^<.*>$'; then

                            echo "ERROR: $NAME is not configured for environment: $ENVIRONMENT"
                            exit 1
                        fi
                    }

                    validate_config "Application repository" "$APPLICATION_REPOSITORY"
                    validate_config "Application branch" "$APPLICATION_BRANCH"
                    validate_config "Environment" "$ENVIRONMENT"

                    validate_config "CF API" "$CF_API"
                    validate_config "CF ORG" "$CF_ORG"
                    validate_config "CF SPACE" "$CF_SPACE"
                    validate_config "CF credentials" "$CF_CREDENTIALS_ID"

                    validate_config "Nexus URL" "$NEXUS_URL"
                    validate_config "Nexus repository" "$NEXUS_REPO"
                    validate_config "Nexus credentials" "$NEXUS_CREDENTIALS_ID"


                    # =====================================================
                    # EXPORT RESOLVED CONFIGURATION
                    # =====================================================

                    cat > branch.env <<EOF
APPLICATION_REPOSITORY=$APPLICATION_REPOSITORY
APPLICATION_BRANCH=$APPLICATION_BRANCH
ENVIRONMENT=$ENVIRONMENT
CF_API=$CF_API
CF_ORG=$CF_ORG
CF_SPACE=$CF_SPACE
CF_CREDENTIALS_ID=$CF_CREDENTIALS_ID
NEXUS_URL=$NEXUS_URL
NEXUS_REPO=$NEXUS_REPO
NEXUS_CREDENTIALS_ID=$NEXUS_CREDENTIALS_ID
EOF
        '''

        script {

            def props = readProperties file: 'branch.env'

            env.APPLICATION_REPOSITORY = props.APPLICATION_REPOSITORY
            env.APPLICATION_BRANCH     = props.APPLICATION_BRANCH
            env.ENVIRONMENT            = props.ENVIRONMENT

            env.CF_API                 = props.CF_API
            env.CF_ORG                 = props.CF_ORG
            env.CF_SPACE               = props.CF_SPACE
            env.CF_CREDENTIALS_ID      = props.CF_CREDENTIALS_ID

            env.NEXUS_URL              = props.NEXUS_URL
            env.NEXUS_REPO             = props.NEXUS_REPO
            env.NEXUS_CREDENTIALS_ID   = props.NEXUS_CREDENTIALS_ID

            echo """
=================================================
Resolved Pipeline Configuration
=================================================
Pipeline:    ${env.PIPELINE_REPOSITORY}@${env.BRANCH_NAME}
Application: ${env.APPLICATION_REPOSITORY}@${env.APPLICATION_BRANCH}
Environment: ${env.ENVIRONMENT}

Cloud Foundry:
  API:        ${env.CF_API}
  Org:        ${env.CF_ORG}
  Space:      ${env.CF_SPACE}

Nexus:
  URL:        ${env.NEXUS_URL}
  Repository: ${env.NEXUS_REPO}

=================================================
"""
        }
    }
}

        // ========================================================
        // CHECKOUT
        // ========================================================

        stage('Checkout Application') {

            steps {

                withCredentials([
                    string(
                        credentialsId: 'gh-token-q8',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "================================================="
                        echo "Checkout Application Repository"
                        echo "================================================="

                        echo "Cloning ${APPLICATION_REPOSITORY}@${APPLICATION_BRANCH}"

                        rm -rf application

                        git clone \
                            --branch "$APPLICATION_BRANCH" \
                            "https://x-access-token:${GITHUB_TOKEN}@github.com/${GH_ORGANIZATION}/${APPLICATION_REPOSITORY}.git" \
                            application

                        cd application

                        echo "Checked out commit: $(git rev-parse --short HEAD)"
                        
                    '''
                }
            }
        }

        // ========================================================
        // VERIFY TOOLCHAIN
        // ========================================================

        stage('Verify Toolchain') {

            steps {

                sh '''

                    set -e

                    echo "================================================="
                    echo "Verify Toolchain"
                    echo "================================================="
                    
                    echo ""
                    echo "Java"
                    java -version

                    echo ""
                    echo "Node"
                    node -v

                    echo ""
                    echo "NPM"
                    npm -v

                    echo ""
                    echo "Git"
                    git --version

                    echo ""
                    echo "Cloud Foundry CLI"
                    cf version

                    echo ""
                    echo "Cloud Foundry Plugins"
                    cf plugins

                    echo ""
                    echo "MBT"
                    mbt --version

                    echo ""
                    echo "CDS"
                    cds --version

                    echo ""
                    echo "Semantic Release"
                    semantic-release --version

                    echo ""
                    echo "JQ"
                    jq --version

                    echo ""
                    echo "YQ"
                    yq --version

                    echo ""
                    echo "Toolchain verification completed"

                '''
            }
        }

        // ========================================================
        // VALIDATE PROJECT
        // ========================================================

        stage('Validate Project') {

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''

                        set -e

                        echo "================================================="
                        echo "Validate CAP Project"
                        echo "================================================="
                        
                        # =================================================
                        # REQUIRED FILES
                        # =================================================

                        [ -f "package.json" ] || {
                            echo "ERROR: package.json not found"
                            exit 1
                        }

                        [ -f "${MTA_FILE}" ] || {
                            echo "ERROR: ${MTA_FILE} not found"
                            exit 1
                        }

                        echo "OK - package.json"
                        echo "OK - ${MTA_FILE}"


                        # =================================================
                        # CAP PROJECT STRUCTURE
                        # =================================================

                        [ -d "srv" ] || {
                            echo "ERROR: srv directory not found"
                            exit 1
                        }

                        [ -d "db" ] || {
                            echo "ERROR: db directory not found"
                            exit 1
                        }

                        echo "OK - srv/"
                        echo "OK - db/"

                        if [ -d "app" ]; then
                            echo "OK - app/"
                        else
                            echo "INFO - app/ not present"
                        fi


                        # =================================================
                        # OPTIONAL SECURITY CONFIGURATION
                        # =================================================

                        if [ -f "xs-security.json" ]; then
                            echo "OK - xs-security.json"
                        else
                            echo "INFO - xs-security.json not present (optional)"
                        fi


                        # =================================================
                        # MTA VALIDATION
                        # =================================================

                        MTA_ID=$(yq -r '.ID' "${MTA_FILE}")
                        MTA_VERSION=$(yq -r '.version' "${MTA_FILE}")

                        if [ -z "$MTA_ID" ] || [ "$MTA_ID" = "null" ]; then
                            echo "ERROR: Invalid MTA ID"
                            exit 1
                        fi

                        if [ -z "$MTA_VERSION" ] || [ "$MTA_VERSION" = "null" ]; then
                            echo "ERROR: Invalid MTA version"
                            exit 1
                        fi


                        # =================================================
                        # PACKAGE VALIDATION
                        # =================================================

                        PACKAGE_NAME=$(jq -r '.name' package.json)
                        PACKAGE_VERSION=$(jq -r '.version // empty' package.json)

                        if [ -z "$PACKAGE_NAME" ] || [ "$PACKAGE_NAME" = "null" ]; then
                            echo "ERROR: package.json name not found"
                            exit 1
                        fi


                        # =================================================
                        # CDS VALIDATION
                        # =================================================

                        echo ""
                        echo "Checking CDS configuration..."

                        cds env > /dev/null


                        # =================================================
                        # VALIDATION SUMMARY
                        # =================================================

                        echo ""
                        echo "================================================="
                        echo "CAP Project Validation Summary"
                        echo "================================================="

                        echo "Package:     $PACKAGE_NAME"
                        echo "Version:     ${PACKAGE_VERSION:-not defined}"
                        echo "MTA ID:      $MTA_ID"
                        echo "MTA version: $MTA_VERSION"

                        echo ""
                        echo "CAP project validation completed successfully"
                        echo "================================================="
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                withCredentials([

                    string(

                        credentialsId: 'gh-token-q8',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                dir("${PROJECT_DIR}") {
                    sh '''
                        set -e

                        if [ -f package-lock.json ]; then

                            echo "package-lock.json found"
                            npm ci --legacy-peer-deps

                        else

                            echo "package-lock.json not found"
                            echo "Generating package-lock.json..."

                            npm install --legacy-peer-deps

                            if [ ! -f package-lock.json ]; then
                                echo "ERROR: package-lock.json generation failed"
                                exit 1
                            fi

                            git add package-lock.json
                            git config user.name "Jenkins"
                            git config user.email "jenkins@your-company.com"
                            git commit -m "chore: generate package-lock.json"
                            git push origin HEAD:${APPLICATION_BRANCH}

                fi
            '''
        }
    }
  }
}


// ========================================================
// SEMANTIC RELEASE
// ========================================================

stage('Semantic Release') {

    steps {

        withCredentials([
            string(
                credentialsId: 'gh-token-q8',
                variable: 'GITHUB_TOKEN'
            )
        ]) {

            dir("${PROJECT_DIR}") {

                withEnv([
                    "BRANCH_NAME=${APPLICATION_BRANCH}",
                    "GIT_BRANCH=${APPLICATION_BRANCH}",
                    "CHANGE_BRANCH="
                ]) {

                    sh '''

                        set +e

                        echo "================================================="
                        echo "Semantic Release"
                        echo "================================================="

                        echo "Repository: ${APPLICATION_REPOSITORY}"
                        echo "Branch:     ${APPLICATION_BRANCH}"
                        echo "Commit:     $(git rev-parse --short HEAD)"

                        echo ""
                        echo "================================================="
                        echo "Running semantic-release"
                        echo "================================================="

                        semantic-release \
                            --dry-run \
                            > semantic.log 2>&1

                        SEMANTIC_EXIT_CODE=$?

                        set -e

                        if [ "$SEMANTIC_EXIT_CODE" -ne 0 ]; then

                            echo ""
                            echo "ERROR: semantic-release failed"
                            echo "Exit code: $SEMANTIC_EXIT_CODE"

                            echo ""
                            echo "Semantic-release output:"
                            cat semantic.log

                            exit "$SEMANTIC_EXIT_CODE"
                        fi


                        # =================================================
                        # NO RELEASE
                        # =================================================

                        if grep -qi "no new version is released" semantic.log; then

                            echo "NO_RELEASE=true" > version.env
                            echo "VERSION=" >> version.env

                            echo ""
                            echo "No new release detected"


                        # =================================================
                        # RELEASE DETECTED
                        # =================================================

                        elif grep -qi "next release version is" semantic.log; then

                            VERSION=$(
                                grep -i "next release version is" semantic.log |
                                grep -Eo '[0-9]+\\.[0-9]+\\.[0-9]+' |
                                head -n 1
                            )

                            if [ -z "$VERSION" ]; then

                                echo "ERROR: Release detected but version could not be determined"

                                exit 1

                            fi

                            echo "NO_RELEASE=false" > version.env
                            echo "VERSION=$VERSION" >> version.env

                            echo ""
                            echo "Next version:"
                            echo "$VERSION"


                        # =================================================
                        # UNEXPECTED RESULT
                        # =================================================

                        else

                            echo ""
                            echo "ERROR: semantic-release did not produce an expected result"
                            echo "semantic-release exit code: $SEMANTIC_EXIT_CODE"

                            exit 1

                        fi


                        echo ""
                        echo "Generated version.env:"
                        cat version.env

                    '''

                    script {

                        def props = readProperties file: 'version.env'

                        env.NO_RELEASE = props.NO_RELEASE ?: 'false'
                        env.VERSION = props.VERSION ?: ''

                        echo "NO_RELEASE = ${env.NO_RELEASE}"
                        echo "VERSION    = ${env.VERSION}"
                        }
                    }
                }
             }
          }
        }

        stage('Update MTA Version') {

            when {
                expression {
                    env.NO_RELEASE != 'true'
                }
            }

            steps {

                dir("${PROJECT_DIR}") {

                    withEnv([
                        "VERSION=${env.VERSION}"
                    ]) {

                        sh '''
                            set -e

                            echo "================================================="
                            echo "Update MTA Version"
                            echo "================================================="

                            if [ -z "$VERSION" ]; then
                                echo "ERROR: VERSION is empty"
                                exit 1
                            fi

                            echo "Updating mta.yaml to version $VERSION"

                            yq -i '.version = strenv(VERSION)' mta.yaml

                            echo ""
                            echo "Updated mta.yaml:"
                            yq '.version' mta.yaml

                            echo ""
                            echo "Git status:"
                            git status
                        '''
                    }
                }
            }
        }

        // ========================================================
        // CDS BUILD
        // ========================================================

        stage('CDS Build') {

             when {
                expression {
                    env.NO_RELEASE != 'true'
                }
            }

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        set -e

                        echo "================================================="
                        echo "CDS Build"
                        echo "================================================="

                        rm -rf gen

                        echo "Installed CDS version:"

                        npx cds --version

                        echo ""
                        echo "Running CDS build..."

                        npx cds build

                        echo "=== gen/srv ==="
                        find gen/srv -maxdepth 2 -type f | sort

                        echo "=== gen/db ==="
                        find gen/db -maxdepth 2 -type f | sort

                        echo "=== srv package files ==="
                        ls -la gen/srv/package*.json

                        echo ""
                        echo "CDS build completed successfully"
                    '''
                }
            }
        }

        // ========================================================
        // CHECK NEXUS ARTIFACT
        // ========================================================

        stage('Check Nexus Artifact') {

    when {
        expression {
            return env.NO_RELEASE != 'true'
        }
    }

    steps {

        script {

            echo "================================================="
            echo "Check Nexus Artifact"
            echo "================================================="

            /*
             * Derive the expected MTAR name before build.
             *
             * Example:
             *   MTA_ID  = kupit-flexiblewf-cap
             *   VERSION = 1.6.12
             *
             *   MTAR_NAME = kupit-flexiblewf-cap_1.6.12.mtar
             */

             dir(env.PROJECT_DIR) {

                env.MTA_ID = sh(
                    script: """
                        yq -r '.ID' '${env.MTA_FILE}'
                    """,
                    returnStdout: true
                ).trim()
            }

            if (!env.MTA_ID || env.MTA_ID == 'null') {
                error("Unable to determine MTA ID from ${env.MTA_FILE}")
            }

            env.MTAR_NAME =
                "${env.MTA_ID}_${env.VERSION}.mtar"

            env.ARTIFACT_PATH =
                "cap/${env.APPLICATION_REPOSITORY}/${env.VERSION}/${env.MTAR_NAME}"

            echo "Expected artifact: ${env.MTAR_NAME}"

            withCredentials([
                usernamePassword(
                    credentialsId: env.NEXUS_CREDENTIALS_ID,
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASSWORD'
                )
            ]) {

                sh '''
                    set +e

                    NEXUS_TARGET="${NEXUS_URL}/repository/${NEXUS_REPO}/${ARTIFACT_PATH}"

                    echo "Version: $VERSION"
                    echo "Artifact: $MTAR_NAME"
                    echo "Path:    $ARTIFACT_PATH"

                    HTTP_CODE=$(
                        curl \
                            --silent \
                            --output /dev/null \
                            --write-out "%{http_code}" \
                            --user "${NEXUS_USER}:${NEXUS_PASSWORD}" \
                            --head \
                            "$NEXUS_TARGET"
                    )

                    CURL_EXIT_CODE=$?

                    if [ "$CURL_EXIT_CODE" -ne 0 ]; then
                        echo ""
                        echo "ERROR: Unable to connect to Nexus"
                        echo "curl exit code: $CURL_EXIT_CODE"
                        echo "HTTP status:    $HTTP_CODE"
                        exit "$CURL_EXIT_CODE"
                    fi

                    case "$HTTP_CODE" in

                        200)
                            echo ""
                            echo "Artifact already exists on Nexus."
                            echo "Release candidate $VERSION will be reused."

                            echo "NEXUS_ARTIFACT_EXISTS=true" \
                                > nexus.env
                            ;;

                        404)
                            echo ""
                            echo "Artifact not found on Nexus."
                            echo "A new release candidate will be built."

                            echo "NEXUS_ARTIFACT_EXISTS=false" \
                                > nexus.env
                            ;;

                        *)
                            echo ""
                            echo "ERROR: Unable to check Nexus artifact"
                            echo "HTTP status: $HTTP_CODE"
                            exit 1
                            ;;
                    esac
                '''

                def props = readProperties file: 'nexus.env'

                env.NEXUS_ARTIFACT_EXISTS =
                    props.NEXUS_ARTIFACT_EXISTS
            }

            echo "Nexus artifact exists: ${env.NEXUS_ARTIFACT_EXISTS}"
        }
    }
}

        // ========================================================
        // BUILD MTAR
        // ========================================================

        stage('Build MTAR') {

            when {
                allOf {
                
                    expression {

                        return env.NO_RELEASE != 'true'
                    }
                    
                    expression {
                        return env.NEXUS_ARTIFACT_EXISTS != 'true'
                    }
                }
            }

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''

                        set -e

                        echo "================================================="
                        echo "Build MTAR"
                        echo "================================================="


                        rm -rf gen

                        rm -rf "${MTAR_DIR}"

                        mbt build -p cf -t "${MTAR_DIR}"

                        MTAR=$(
                            find "${MTAR_DIR}" \
                                -type f \
                                -name "*.mtar" |
                            head -n 1
                        )

                        ACTUAL_MTAR_NAME=$(basename "$MTAR")

                        if [ "$ACTUAL_MTAR_NAME" != "$MTAR_NAME" ]; then
                            echo "ERROR: Unexpected MTAR name"
                            echo "Expected: $MTAR_NAME"
                            echo "Actual:   $ACTUAL_MTAR_NAME"
                            exit 1
                        fi

                        if [ -z "$MTAR" ]; then
                            echo "ERROR: MTAR was not generated"
                            exit 1
                        fi

                        echo "Generated artifact: $MTAR"

                        cat > artifact.env <<EOF
BUILT_MTAR=$MTAR
EOF
                    '''

                    script {

                        def props =
                            readProperties file: 'artifact.env'

                        env.BUILT_MTAR =
                            props.BUILT_MTAR

                    }
                }
            }
        }

        // ========================================================
        // PUBLISH NEXUS ARTIFACT
        // ========================================================

        stage('Publish Nexus Artifact') {

            when {
                allOf {

                    expression {
                        return env.NO_RELEASE != 'true'
                    }

                    expression {
                        return env.NEXUS_ARTIFACT_EXISTS != 'true'
                    }
                }
            }

            steps {

                script {

                    echo "================================================="
                    echo "Publish Nexus Artifact"
                    echo "================================================="

                    withCredentials([
                        usernamePassword(
                            credentialsId: env.NEXUS_CREDENTIALS_ID,
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {

                        dir(env.PROJECT_DIR) {

                            sh '''
                                set -e

                                if [ ! -f "$BUILT_MTAR" ]; then
                                    echo "ERROR: Built MTAR not found: $BUILT_MTAR"
                                    exit 1
                                fi

                                NEXUS_TARGET="${NEXUS_URL}/repository/${NEXUS_REPO}/${ARTIFACT_PATH}"

                                echo "MTAR:       $MTAR"
                                echo "Version:    $VERSION"

                                curl \
                                    --fail \
                                    --show-error \
                                    --silent \
                                    --user "${NEXUS_USER}:${NEXUS_PASSWORD}" \
                                    --upload-file "$BUILT_MTAR" \
                                    "$NEXUS_TARGET"

                                echo ""
                                echo "Artifact successfully published to Nexus"
                            '''
                        }
                    }
                }
            }
        }

        stage('Download Nexus Artifact') {

    when {
        expression {
            return env.NO_RELEASE != 'true'
        }
    }

    steps {

        script {

            echo "================================================="
            echo "Download Nexus Artifact"
            echo "================================================="

            withCredentials([
                usernamePassword(
                    credentialsId: env.NEXUS_CREDENTIALS_ID,
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASSWORD'
                )
            ]) {

                dir(env.PROJECT_DIR) {

                    sh '''
                        set -e

                        DOWNLOAD_DIR="${MTAR_DIR}/nexus"

                        rm -rf "$DOWNLOAD_DIR"
                        mkdir -p "$DOWNLOAD_DIR"

                        DEPLOY_MTAR="${DOWNLOAD_DIR}/${MTAR_NAME}"

                        NEXUS_TARGET="${NEXUS_URL}/repository/${NEXUS_REPO}/${ARTIFACT_PATH}"

                        echo "Version: $VERSION"
                        echo "Path:    $ARTIFACT_PATH"

                        echo ""
                        echo "Downloading artifact from Nexus..."

                        curl \
                            --fail \
                            --show-error \
                            --silent \
                            --user "${NEXUS_USER}:${NEXUS_PASSWORD}" \
                            --output "$DEPLOY_MTAR" \
                            "$NEXUS_TARGET"

                        if [ ! -s "$DEPLOY_MTAR" ]; then
                            echo "ERROR: Downloaded MTAR is empty or missing"
                            exit 1
                        fi


                        # =========================================
                        # ARTIFACT INTEGRITY
                        # =========================================

                        if [ "$NEXUS_ARTIFACT_EXISTS" = "false" ]; then

                            echo ""
                            echo "Verifying published artifact integrity..."

                            if [ ! -f "$BUILT_MTAR" ]; then
                                echo "ERROR: Built MTAR not found: $BUILT_MTAR"
                                exit 1
                            fi

                            BUILT_SHA256=$(
                                sha256sum "$BUILT_MTAR" |
                                awk '{print $1}'
                            )

                            NEXUS_SHA256=$(
                                sha256sum "$DEPLOY_MTAR" |
                                awk '{print $1}'
                            )

                            echo "Built artifact SHA256: $BUILT_SHA256"
                            echo "Nexus artifact SHA256: $NEXUS_SHA256"

                            if [ "$BUILT_SHA256" != "$NEXUS_SHA256" ]; then

                                echo ""
                                echo "ERROR: Nexus artifact differs from uploaded artifact"
                                exit 1

                            fi

                            echo ""
                            echo "Artifact integrity verified"

                        else

                            NEXUS_SHA256=$(
                                sha256sum "$DEPLOY_MTAR" |
                                awk '{print $1}'
                            )

                            echo ""
                            echo "Existing Nexus release candidate reused"
                            echo "SHA256: $NEXUS_SHA256"

                        fi


                        # =========================================
                        # DEPLOYMENT ARTIFACT
                        # =========================================

                        cat > deploy.env <<EOF
DEPLOY_MTAR=$DEPLOY_MTAR
EOF
                    '''

                    script {

                        def props = readProperties file: 'deploy.env'

                        env.DEPLOY_MTAR = props.DEPLOY_MTAR

                        echo "Deployment artifact: ${env.DEPLOY_MTAR}"
                    }
                }
            }
        }
    }
}



        // ========================================================
        // DEPLOY
        // ========================================================

        stage('Deploy') {

            when {
                expression {
                    return env.NO_RELEASE != 'true'
                }
            }

            steps {

                script {

                    echo "Environment: ${env.ENVIRONMENT}"
                    echo "Deploy MTAR: ${env.DEPLOY_MTAR}"
                    
                    deployToEnvironment(
                        env.ENVIRONMENT,
                        env.DEPLOY_MTAR
                    )
                }
            }
        }
		
		stage('Approval - Promote to Test') {

			when {
				expression {
					return env.NO_RELEASE != 'true'
				}
			}

			steps {

				script {

					input(
						message: "Promote version ${env.VERSION} from DEV to TEST?",
						ok: "Approve Promotion"
					)

				}

			}
		}
		
		stage('Promote to Test') {

			when {
				expression {
					return env.NO_RELEASE != 'true'
				}
			}

			steps {

				echo "================================================="
				echo "Promote Artifact"
				echo "================================================="

				echo "Version: ${env.VERSION}"
				echo "Source environment: DEV"
				echo "Target environment: TEST"

				echo ""
				echo "TEST deployment is currently simulated."
				echo "No real Cloud Foundry deployment will be executed."

			}
		}

        stage('Commit & Tag Release') {

            when {
                expression {
                    env.NO_RELEASE != 'true'
                }
            }

            steps {

                withCredentials([
                    string(
                        credentialsId: 'gh-token-q8',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    dir("${PROJECT_DIR}") {

                        sh '''
                            set -e

                            echo "================================================="
                            echo "Commit & Tag Release"
                            echo "================================================="

                            if [ -z "$VERSION" ]; then
                                echo "ERROR: VERSION is empty"
                                exit 1
                            fi

                            echo "Release version: $VERSION"


                            echo ""
                            echo "Configuring Git identity..."

                            git config user.email "ci@jenkins"
                            git config user.name "Jenkins CI"


                            echo ""
                            echo "Updating package.json and package-lock.json..."

                            npm version "$VERSION" --no-git-tag-version


                            echo ""
                            echo "Updating mta.yaml..."

                            yq -i '.version = strenv(VERSION)' mta.yaml


                            echo ""
                            echo "Verifying versions..."

                            PACKAGE_VERSION=$(jq -r '.version' package.json)
                            PACKAGE_LOCK_VERSION=$(jq -r '.version' package-lock.json)
                            MTA_VERSION=$(yq -r '.version' mta.yaml)

                            echo "package.json version: $PACKAGE_VERSION"
                            echo "package-lock.json version: $PACKAGE_LOCK_VERSION"
                            echo "mta.yaml version:     $MTA_VERSION"


                            if [ "$PACKAGE_VERSION" != "$VERSION" ]; then
                                echo "ERROR: package.json version mismatch"
                                exit 1
                            fi

                            if [ "$PACKAGE_LOCK_VERSION" != "$VERSION" ]; then
                                echo "ERROR: package-lock.json version mismatch"
                                exit 1
                            fi

                            if [ "$MTA_VERSION" != "$VERSION" ]; then
                                echo "ERROR: mta.yaml version mismatch"
                                exit 1
                            fi


                            echo ""
                            echo "Commit..."

                            git add package.json package-lock.json mta.yaml

                            git commit \
                                -m "chore(release): $VERSION [skip ci]" \
                                || echo "No changes to commit"


                            echo ""
                            echo "Create tag..."

                            git tag "v$VERSION"


                            echo ""
                            echo "Push branch..."

                            if [ -z "$APPLICATION_BRANCH" ]; then
                                echo "ERROR: APPLICATION_BRANCH is empty"
                                exit 1
                            fi

                            echo "Target branch: $APPLICATION_BRANCH"

                            git push origin "HEAD:${APPLICATION_BRANCH}"

                            echo ""
                            echo "Push tag..."

                            git push origin "v$VERSION"


                            echo ""
                            echo "================================================="
                            echo "Release completed successfully"
                            echo "Version: $VERSION"
                            echo "================================================="
                        '''
                    }
                }
            }
        }        
}


    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {

        success {

            script {

                if (env.NO_RELEASE == 'true') {

                    echo '''
=================================================
CAP PIPELINE COMPLETED - NO NEW RELEASE
=================================================
'''

                } else {

                    echo """
=================================================
CAP PIPELINE COMPLETED SUCCESSFULLY
Release: ${env.VERSION}
=================================================
"""
                }
            }
        }


        failure {

            echo '''

            =================================================
            CAP PIPELINE FAILED
            =================================================

            '''
        }


        always {

            cleanWs()
        }
    }
}
