// ================================================================
// Q8 DevOps CAP Template v2.0
// ================================================================

pipeline {
    agent any
    
    options {
        ansiColor('xterm')
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        skipStagesAfterUnstable()
    }

    environment {

        // ========================================================
        // PROJECT
        // ========================================================

        PROJECT_DIR = 'application'
        
		CONFIG_FILE = 'pipeline/config/cap.yaml'
		
		MTA_FILE = 'mta.yaml'
        MTAR_DIR = 'mta_archives'

        // ========================================================
        // GITHUB
        // ========================================================

        GH_ORGANIZATION = 'Organization1102'
        PIPELINE_REPOSITORY = 'sap-btp-cicd'
    }

    stages {
	
		stage('Checkout Pipeline') {

			steps {
	
				withCredentials([
					string(
						credentialsId: 'gh-token-q8',
						variable: 'GITHUB_TOKEN'
					)
				]) {

					sh '''
						set -e

						echo "================================================="
						echo "Checkout Pipeline Repository"
						echo "================================================="

						echo "Repository:"
						echo "$PIPELINE_REPOSITORY"

						echo "Branch:"
						echo "$BRANCH_NAME"

						git clone \
							--branch "$BRANCH_NAME" \
							"https://x-access-token:${GITHUB_TOKEN}@github.com/${GH_ORGANIZATION}/${PIPELINE_REPOSITORY}.git" \
							pipeline
					'''
				}
			}
		}
	
		stage('Load Configuration') {

			steps {

				sh '''

					set -e

					echo "================================================="
					echo "Load Pipeline Configuration"
					echo "================================================="

					echo ""
					echo "Pipeline branch:"
					echo "$BRANCH_NAME"
								
					echo ""
					echo "Configuration file:"
					echo "$CONFIG_FILE"

					if [ ! -f "$CONFIG_FILE" ]; then

						echo "ERROR: Configuration file not found:"
						echo "$CONFIG_FILE"

						exit 1

					fi

					echo ""
					echo "Configuration:"
					cat "$CONFIG_FILE"

					echo ""
					echo "Technology:"

					yq -r '.technology' "$CONFIG_FILE"

					echo ""
					echo "Application repository:"

					APPLICATION_REPOSITORY=$(
						yq -r '.application.repository' "$CONFIG_FILE"
					)

					echo "$APPLICATION_REPOSITORY"

					echo ""
					echo "Resolving application branch..."

					case "$BRANCH_NAME" in

						main)

							APPLICATION_BRANCH=$(
								yq -r '.branchStrategy.main.applicationBranch' "$CONFIG_FILE"
							)

                            ENVIRONMENT=$(
                                yq -r '.branchStrategy.main.environment' "$CONFIG_FILE"
                            )

							;;

						develop)

							APPLICATION_BRANCH=$(
								yq -r '.branchStrategy.develop.applicationBranch' "$CONFIG_FILE"
							)

                            ENVIRONMENT=$(
                                yq -r '.branchStrategy.develop.environment' "$CONFIG_FILE"
                            )

							;;

						feature/*)

							APPLICATION_BRANCH=$(
								yq -r '.branchStrategy."feature/*".applicationBranch' "$CONFIG_FILE"
							)

                            ENVIRONMENT=$(
                                yq -r '.branchStrategy."feature/*".environment' "$CONFIG_FILE"
                            )

							;;

						*)

							echo "ERROR: No branch strategy configured for:"
							echo "$BRANCH_NAME"

							exit 1

							;;

					esac

                    echo ""
                    echo "Resolving environment configuration..."

                    if [ -z "$ENVIRONMENT" ] || [ "$ENVIRONMENT" = "null" ]; then

                        echo "ERROR: Environment could not be resolved"

                        exit 1

                    fi

                    CF_API=$(
                        yq -r ".environment.${ENVIRONMENT}.cf.api" "$CONFIG_FILE"
                    )

                    CF_ORG=$(
                        yq -r ".environment.${ENVIRONMENT}.cf.org" "$CONFIG_FILE"
                    )

                    CF_SPACE=$(
                        yq -r ".environment.${ENVIRONMENT}.cf.space" "$CONFIG_FILE"
                    )

                    CF_CREDENTIALS_ID=$(
                        yq -r ".environment.${ENVIRONMENT}.credentials.cf" "$CONFIG_FILE"
                    )

                    NEXUS_REPO=$(
                        yq -r ".environment.${ENVIRONMENT}.nexus.repository" "$CONFIG_FILE"
                    )

                    if [ -z "$NEXUS_REPO" ] || \
                       [ "$NEXUS_REPO" = "null" ] || \
                       echo "$NEXUS_REPO" | grep -q '^<.*>$'; then

                        echo "WARNING: Nexus repository is not configured for environment: $ENVIRONMENT"
                        echo "Nexus publication will not be available"

                        NEXUS_REPO=""
                    fi

                    validate_config() {

                        NAME="$1"
                        VALUE="$2"

                        if [ -z "$VALUE" ] || \
                           [ "$VALUE" = "null" ] || \
                           echo "$VALUE" | grep -q '^<.*>$'; then

                            echo "ERROR: $NAME is not configured for environment: $ENVIRONMENT"
                            exit 1

                        fi
                    }

                    validate_config "Application repository" "$APPLICATION_REPOSITORY"
                    validate_config "Application branch" "$APPLICATION_BRANCH"
                    validate_config "Environment" "$ENVIRONMENT"

                    validate_config "CF API" "$CF_API"
                    validate_config "CF ORG" "$CF_ORG"
                    validate_config "CF SPACE" "$CF_SPACE"
                    validate_config "CF credentials" "$CF_CREDENTIALS_ID"
                    
					echo ""
					echo "================================================="
					echo "Resolved Configuration"
					echo "================================================="

					echo "Pipeline branch:        $BRANCH_NAME"
					echo "Application repository: $APPLICATION_REPOSITORY"
					echo "Application branch:     $APPLICATION_BRANCH"
                    echo "Environment:            $ENVIRONMENT"

                    echo "CF API:                 $CF_API"
                    echo "CF ORG:                 $CF_ORG"
                    echo "CF SPACE:               $CF_SPACE"

                    echo "CF credentials ID:      $CF_CREDENTIALS_ID"

                    echo "Nexus repository:       $NEXUS_REPO"

					echo ""

					echo "APPLICATION_REPOSITORY=$APPLICATION_REPOSITORY" > branch.env
					echo "APPLICATION_BRANCH=$APPLICATION_BRANCH" >> branch.env

                    echo "ENVIRONMENT=$ENVIRONMENT" >> branch.env

                    echo "CF_API=$CF_API" >> branch.env
                    echo "CF_ORG=$CF_ORG" >> branch.env
                    echo "CF_SPACE=$CF_SPACE" >> branch.env

                    echo "CF_CREDENTIALS_ID=$CF_CREDENTIALS_ID" >> branch.env

                    echo "NEXUS_REPO=$NEXUS_REPO" >> branch.env

				'''

				script {

					def props = readProperties file: 'branch.env'

					env.APPLICATION_REPOSITORY = props.APPLICATION_REPOSITORY
					env.APPLICATION_BRANCH = props.APPLICATION_BRANCH

                    env.ENVIRONMENT            = props.ENVIRONMENT

                    env.CF_API                 = props.CF_API
                    env.CF_ORG                 = props.CF_ORG
                    env.CF_SPACE               = props.CF_SPACE

                    env.CF_CREDENTIALS_ID      = props.CF_CREDENTIALS_ID

                    env.NEXUS_REPO             = props.NEXUS_REPO

					echo "APPLICATION_REPOSITORY = ${env.APPLICATION_REPOSITORY}"
					echo "APPLICATION_BRANCH     = ${env.APPLICATION_BRANCH}"

                    echo "ENVIRONMENT            = ${env.ENVIRONMENT}"

					echo "CF_API                 = ${env.CF_API}"
                    echo "CF_ORG                 = ${env.CF_ORG}"
                    echo "CF_SPACE               = ${env.CF_SPACE}"
                    
                    echo "CF_CREDENTIALS_ID      = ${env.CF_CREDENTIALS_ID}"

                    echo "NEXUS_REPO             = ${env.NEXUS_REPO}"
				}
			}
		}

        // ========================================================
        // CHECKOUT
        // ========================================================

        stage('Checkout Application') {

            steps {

                withCredentials([
                    string(
                        credentialsId: 'gh-token-q8',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "================================================="
                        echo "Checkout Application Repository"
                        echo "================================================="

                        echo ""
                        echo "Pipeline Repository:"
                        echo "$PIPELINE_REPOSITORY"

                        echo ""
                        echo "Application Repository:"
                        echo "$APPLICATION_REPOSITORY"

                        echo ""
                        echo "Branch:"
                        echo "$APPLICATION_BRANCH"

                        rm -rf application

                        git clone \
                            --branch "$APPLICATION_BRANCH" \
                            "https://x-access-token:${GITHUB_TOKEN}@github.com/${GH_ORGANIZATION}/${APPLICATION_REPOSITORY}.git" \
                            application

                        cd application

                        echo ""
                        echo "Application repository checked out"

                        echo ""
                        echo "Current directory:"
                        pwd

                        echo ""
                        echo "Git status:"
                        git status

                        echo ""
                        echo "Repository content:"
                        ls -la

                        echo ""
                        echo "Checking package.json..."

                        if [ ! -f package.json ]; then
                            echo "ERROR: package.json not found"
                            exit 1
                        fi

                        echo "OK - package.json found"

                        echo ""
                        echo "Checking mta.yaml..."

                        if [ ! -f mta.yaml ]; then
                            echo "ERROR: mta.yaml not found"
                            exit 1
                        fi

                        echo "OK - mta.yaml found"
                    '''
                }
            }
        }

        // ========================================================
        // VERIFY ENVIRONMENT
        // ========================================================

        stage('Verify Environment') {

            steps {

                sh '''

                    set -e

                    echo "================================================="
                    echo "Verify Build Environment"
                    echo "================================================="

                    echo ""
                    echo "Deployment Environment"
                    echo "Environment: $ENVIRONMENT"
                    echo "CF API:      $CF_API"
                    echo "CF ORG:      $CF_ORG" 
                    echo "CF SPACE:    $CF_SPACE"
                    
                    echo ""
                    echo "Java"
                    java -version

                    echo ""
                    echo "Node"
                    node -v

                    echo ""
                    echo "NPM"
                    npm -v

                    echo ""
                    echo "Git"
                    git --version

                    echo ""
                    echo "Cloud Foundry CLI"
                    cf version

                    echo ""
                    echo "Cloud Foundry Plugins"
                    cf plugins

                    echo ""
                    echo "MBT"
                    mbt --version

                    echo ""
                    echo "CDS"
                    cds --version

                    echo ""
                    echo "Semantic Release"
                    semantic-release --version

                    echo ""
                    echo "JQ"
                    jq --version

                    echo ""
                    echo "YQ"
                    yq --version

                    echo ""
                    echo "Environment verification completed"

                '''
            }
        }

        // ========================================================
        // VALIDATE PROJECT
        // ========================================================

        stage('Validate Project') {

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''

                        set -e

                        echo "================================================="
                        echo "Validate CAP Project"
                        echo "================================================="

                        echo ""
                        echo "Current directory:"
                        pwd

                        echo ""
                        echo "Repository content:"
                        ls -la


                        # ------------------------------------------------
                        # package.json
                        # ------------------------------------------------

                        echo ""
                        echo "Checking package.json..."

                        if [ ! -f "package.json" ]; then

                            echo "ERROR: package.json not found"

                            exit 1

                        fi

                        echo "OK - package.json found"


                        # ------------------------------------------------
                        # mta.yaml
                        # ------------------------------------------------

                        echo ""
                        echo "Checking mta.yaml..."

                        if [ ! -f "mta.yaml" ]; then

                            echo "ERROR: mta.yaml not found"

                            exit 1

                        fi

                        echo "OK - mta.yaml found"


                        # ------------------------------------------------
                        # CAP directories
                        # ------------------------------------------------

                        echo ""
                        echo "Checking CAP project structure..."


                        if [ ! -d "srv" ]; then

                            echo "ERROR: srv directory not found"

                            exit 1

                        fi

                        echo "OK - srv directory found"


                        if [ ! -d "db" ]; then

                            echo "ERROR: db directory not found"

                            exit 1

                        fi

                        echo "OK - db directory found"


                        if [ -d "app" ]; then

                            echo "OK - app directory found"

                        else

                            echo "INFO - app directory not found"

                        fi


                        # ------------------------------------------------
                        # xs-security.json
                        # ------------------------------------------------

                        echo ""
                        echo "Checking security configuration..."


                        if [ -f "xs-security.json" ]; then

                            echo "OK - xs-security.json found"

                        else

                            echo "WARNING - xs-security.json not found"

                            echo "Continuing because it is optional"

                        fi


                        # ------------------------------------------------
                        # MTA validation
                        # ------------------------------------------------

                        echo ""
                        echo "Validating mta.yaml..."

                        MTA_ID=$(yq '.ID' "${MTA_FILE}")

                        if [ -z "$MTA_ID" ] || [ "$MTA_ID" = "null" ]; then

                            echo "ERROR: Invalid MTA ID"

                            exit 1

                        fi

                        echo "MTA ID: $MTA_ID"


                        MTA_VERSION=$(yq '.version' "${MTA_FILE}")

                        echo "MTA version: $MTA_VERSION"


                        # ------------------------------------------------
                        # package.json validation
                        # ------------------------------------------------

                        echo ""
                        echo "Validating package.json..."

                        PACKAGE_NAME=$(jq -r '.name' package.json)

                        if [ "$PACKAGE_NAME" = "null" ]; then

                            echo "ERROR: package.json name not found"

                            exit 1

                        fi

                        echo "Package name: $PACKAGE_NAME"


                        # ------------------------------------------------
                        # CDS validation
                        # ------------------------------------------------

                        echo ""
                        echo "Checking CDS project..."

                        cds env


                        echo ""
                        echo "================================================="
                        echo "CAP project validation completed successfully"
                        echo "================================================="

                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                withCredentials([

                    string(

                        credentialsId: 'gh-token-q8',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                dir("${PROJECT_DIR}") {
                    sh '''
                        set -e

                        if [ -f package-lock.json ]; then

                            echo "package-lock.json found"
                            npm ci --legacy-peer-deps

                        else

                            echo "package-lock.json not found"
                            echo "Generating package-lock.json..."

                            npm install --legacy-peer-deps

                            if [ ! -f package-lock.json ]; then
                                echo "ERROR: package-lock.json generation failed"
                                exit 1
                            fi

                            git add package-lock.json
                            git config user.name "Jenkins"
                            git config user.email "jenkins@your-company.com"
                            git commit -m "chore: generate package-lock.json"
                            git push origin HEAD:${APPLICATION_BRANCH}

                fi
            '''
        }
    }
  }
}


// ========================================================
// SEMANTIC RELEASE
// ========================================================

stage('Semantic Release') {

    steps {

        withCredentials([
            string(
                credentialsId: 'gh-token-q8',
                variable: 'GITHUB_TOKEN'
            )
        ]) {

            dir("${PROJECT_DIR}") {

                withEnv([
                    "BRANCH_NAME=${APPLICATION_BRANCH}",
                    "GIT_BRANCH=${APPLICATION_BRANCH}",
                    "CHANGE_BRANCH="
                ]) {

                    sh '''

                        set -e

                        echo "================================================="
                        echo "Semantic Release"
                        echo "================================================="

                        echo ""
                        echo "Application repository:"
                        echo "$APPLICATION_REPOSITORY"

                        echo ""
                        echo "Application branch:"
                        echo "$APPLICATION_BRANCH"

                        echo ""
                        echo "================================================="
                        echo "SEMANTIC RELEASE CONTEXT"
                        echo "================================================="

                        echo ""
                        echo "Jenkins/Semantic BRANCH_NAME:"
                        echo "$BRANCH_NAME"

                        echo ""
                        echo "GIT_BRANCH:"
                        echo "${GIT_BRANCH:-<unset>}"

                        echo ""
                        echo "CHANGE_BRANCH:"
                        echo "${CHANGE_BRANCH:-<unset>}"

                        echo ""
                        echo "Actual Git branch:"
                        git branch --show-current

                        echo ""
                        echo "Git status:"
                        git status --short

                        echo ""
                        echo "Git remote:"
                        git remote -v

                        echo ""
                        echo "Git HEAD:"
                        git rev-parse HEAD

                        echo ""
                        echo "package.json:"
                        jq '.name, .version' package.json

                        echo ""
                        echo "Semantic release configuration:"
                        jq '.release // empty' package.json

                        echo ""
                        echo "================================================="
                        echo "Running semantic-release"
                        echo "================================================="

                        semantic-release \
                            --dry-run \
                            > semantic.log 2>&1

                        SEMANTIC_EXIT_CODE=$?

                        echo ""
                        echo "Semantic-release output:"
                        cat semantic.log

                        echo ""
                        echo "Semantic-release exit code:"
                        echo "$SEMANTIC_EXIT_CODE"


                        # =================================================
                        # NO RELEASE
                        # =================================================

                        if grep -qi "no new version is released" semantic.log; then

                            echo "NO_RELEASE=true" > version.env
                            echo "VERSION=" >> version.env

                            echo ""
                            echo "No new release detected"


                        # =================================================
                        # RELEASE DETECTED
                        # =================================================

                        elif grep -qi "next release version is" semantic.log; then

                            VERSION=$(
                                grep -i "next release version is" semantic.log |
                                grep -Eo '[0-9]+\\.[0-9]+\\.[0-9]+' |
                                head -n 1
                            )

                            if [ -z "$VERSION" ]; then

                                echo "ERROR: Release detected but version could not be determined"

                                exit 1

                            fi

                            echo "NO_RELEASE=false" > version.env
                            echo "VERSION=$VERSION" >> version.env

                            echo ""
                            echo "Next version:"
                            echo "$VERSION"


                        # =================================================
                        # UNEXPECTED RESULT
                        # =================================================

                        else

                            echo ""
                            echo "ERROR: semantic-release did not produce an expected result"
                            echo "semantic-release exit code: $SEMANTIC_EXIT_CODE"

                            exit 1

                        fi


                        echo ""
                        echo "Generated version.env:"
                        cat version.env

                    '''

                    script {

                        def props = readProperties file: 'version.env'

                        env.NO_RELEASE = props.NO_RELEASE ?: 'false'
                        env.VERSION = props.VERSION ?: ''

                        echo "NO_RELEASE = ${env.NO_RELEASE}"
                        echo "VERSION    = ${env.VERSION}"
                        }
                    }
                }
             }
          }
        }

        stage('Update MTA Version') {

            when {
                expression {
                    env.NO_RELEASE != 'true'
                }
            }

            steps {

                dir("${PROJECT_DIR}") {

                    withEnv([
                        "VERSION=${env.VERSION}"
                    ]) {

                        sh '''
                            set -e

                            echo "================================================="
                            echo "Update MTA Version"
                            echo "================================================="

                            if [ -z "$VERSION" ]; then
                                echo "ERROR: VERSION is empty"
                                exit 1
                            fi

                            echo "Updating mta.yaml to version $VERSION"

                            yq -i '.version = strenv(VERSION)' mta.yaml

                            echo ""
                            echo "Updated mta.yaml:"
                            yq '.version' mta.yaml

                            echo ""
                            echo "Git status:"
                            git status
                        '''
                    }
                }
            }
        }

        // ========================================================
        // CDS BUILD
        // ========================================================

        stage('CDS Build') {

             when {
                expression {
                    env.NO_RELEASE == 'false'
                }
            }

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        set -e

                        echo "================================================="
                        echo "CDS Build"
                        echo "================================================="

                        rm -rf gen

                        echo "Installed CDS version:"

                        npx cds --version

                        echo ""
                        echo "Running CDS build..."

                        npx cds build

                        echo "=== gen/srv ==="
                        find gen/srv -maxdepth 2 -type f | sort

                        echo "=== gen/db ==="
                        find gen/db -maxdepth 2 -type f | sort

                        echo "=== srv package files ==="
                        ls -la gen/srv/package*.json

                        echo ""
                        echo "CDS build completed successfully"
                    '''
                }
            }
        }

        // ========================================================
        // BUILD MTAR
        // ========================================================

        stage('Build MTAR') {

            when {

                expression {

                    env.NO_RELEASE != 'true'
                }
            }

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''

                        set -e

                        echo "================================================="
                        echo "Build MTAR"
                        echo "================================================="


                        rm -rf gen

                        rm -rf "${MTAR_DIR}"


                        echo "Running MBT build..."

                        mbt build -p cf -t "${MTAR_DIR}"


                        echo ""

                        echo "Generated artifacts:"

                        ls -lah "${MTAR_DIR}"


                        MTAR=$(

                            find "${MTAR_DIR}" -name "*.mtar" | head -n 1)


                        if [ -z "$MTAR" ]; then

                            echo "ERROR: MTAR was not generated"

                            exit 1

                        fi


                        echo ""

                        echo "MTAR generated successfully:"

                        echo "$MTAR"

                    '''
                }
            }
        }

        // ========================================================
        // PUBLISH NEXUS
        // ========================================================

        stage('Publish Nexus') {

            when {

                expression {

                    env.NO_RELEASE != 'true'
                }
            }

            steps {

                echo "Nexus publication placeholder"

                echo "NEXUS_URL  = ${env.NEXUS_URL}"

                echo "NEXUS_REPO = ${env.NEXUS_REPO}"
            }
        }

        // ========================================================
        // DEPLOY
        // ========================================================

        stage('Deploy') {

            when {

                expression {

                    env.NO_RELEASE != 'true'
                }
            }

            steps {

                withCredentials([

                    usernamePassword(

                        credentialsId: env.CF_CREDENTIALS_ID,

                        usernameVariable: 'CF_USER',

                        passwordVariable: 'CF_PASSWORD'
                    )
                ]) {

                    dir("${PROJECT_DIR}") {

                        sh '''

                            set -e

                            echo "================================================="
                            echo "Deploy to SAP BTP"
                            echo "================================================="


                            MTAR=$(find "${MTAR_DIR}" -name "*.mtar" | head -n 1)


                            if [ -z "$MTAR" ]; then

                                echo "ERROR: MTAR not found"

                                exit 1

                            fi


                            echo "MTAR: $MTAR"


                            echo ""

                            echo "CF API: $CF_API"

                            echo "CF ORG: $CF_ORG"

                            echo "CF SPACE: $CF_SPACE"


                            cf api "$CF_API"


                            cf auth "$CF_USER" "$CF_PASSWORD"


                            cf target -o "$CF_ORG" -s "$CF_SPACE"


                            echo ""

                            echo "Deploying MTAR..."


                            cf deploy "$MTAR" -f


                            echo ""

                            echo "Deployment completed successfully"

                        '''
                    }
                }
            }
        }

        stage('Commit & Tag Release') {

            when {
                expression {
                    env.NO_RELEASE != 'true'
                }
            }

            steps {

                withCredentials([
                    string(
                        credentialsId: 'gh-token-q8',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    dir("${PROJECT_DIR}") {

                        sh '''
                            set -e

                            echo "================================================="
                            echo "Commit & Tag Release"
                            echo "================================================="

                            if [ -z "$VERSION" ]; then
                                echo "ERROR: VERSION is empty"
                                exit 1
                            fi

                            echo "Release version: $VERSION"


                            echo ""
                            echo "Configuring Git identity..."

                            git config user.email "ci@jenkins"
                            git config user.name "Jenkins CI"


                            echo ""
                            echo "Updating package.json and package-lock.json..."

                            npm version "$VERSION" --no-git-tag-version


                            echo ""
                            echo "Updating mta.yaml..."

                            yq -i '.version = strenv(VERSION)' mta.yaml


                            echo ""
                            echo "Verifying versions..."

                            PACKAGE_VERSION=$(jq -r '.version' package.json)
                            PACKAGE_LOCK_VERSION=$(jq -r '.version' package-lock.json)
                            MTA_VERSION=$(yq -r '.version' mta.yaml)

                            echo "package.json version: $PACKAGE_VERSION"
                            echo "package-lock.json version: $PACKAGE_LOCK_VERSION"
                            echo "mta.yaml version:     $MTA_VERSION"


                            if [ "$PACKAGE_VERSION" != "$VERSION" ]; then
                                echo "ERROR: package.json version mismatch"
                                exit 1
                            fi

                            if [ "$PACKAGE_LOCK_VERSION" != "$VERSION" ]; then
                                echo "ERROR: package-lock.json version mismatch"
                                exit 1
                            fi

                            if [ "$MTA_VERSION" != "$VERSION" ]; then
                                echo "ERROR: mta.yaml version mismatch"
                                exit 1
                            fi


                            echo ""
                            echo "Git status..."

                            git status


                            echo ""
                            echo "Commit..."

                            git add package.json package-lock.json mta.yaml

                            git commit \
                                -m "chore(release): $VERSION [skip ci]" \
                                || echo "No changes to commit"


                            echo ""
                            echo "Create tag..."

                            git tag -f "v$VERSION"


                            echo ""
                            echo "Push branch..."

                            if [ -z "$APPLICATION_BRANCH" ]; then
                                echo "ERROR: APPLICATION_BRANCH is empty"
                                exit 1
                            fi

                            echo "Target branch: $APPLICATION_BRANCH"

                            git push origin "HEAD:${APPLICATION_BRANCH}"

                            echo ""
                            echo "Push tag..."

                            git push origin "v$VERSION" --force


                            echo ""
                            echo "================================================="
                            echo "Release completed successfully"
                            echo "Version: $VERSION"
                            echo "================================================="
                        '''
                    }
                }
            }
        }        
}


    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {

        success {

            echo '''

            =================================================
            CAP PIPELINE COMPLETED SUCCESSFULLY
            =================================================

            '''
        }


        unstable {

            echo '''

            =================================================
            CAP PIPELINE COMPLETED WITHOUT NEW RELEASE
            =================================================

            '''
        }


        failure {

            echo '''

            =================================================
            CAP PIPELINE FAILED
            =================================================

            '''
        }


        always {

            cleanWs()
        }
    }
}
