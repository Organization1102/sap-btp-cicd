pipeline {

  agent none

  options {
    ansiColor('xterm')
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  environment {
    CF_API   = 'https://api.cf.eu10-004.hana.ondemand.com'
    CF_ORG   = 'Kuwait Petroleum Italia S.p.A.'
    CF_SPACE = 'FlexibleV1'

    GH_ORGANIZATION = 'KPICorporate'
    REPOSITORY_NAME = 'sap-btp-cicd'
    JENKINS_ENV     = 'PROD'
  }

  stages {

    /* =========================================================
     * CHECKOUT (GH POD)
     * ========================================================= */
    stage('Checkout') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'gh',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('gh') {

          script {

            def repoUrl = "git@github.com:${env.GH_ORGANIZATION}/${env.REPOSITORY_NAME}.git"

            def dkName = (
              "AUT-PLAT-${env.JENKINS_ENV}-DK-${env.REPOSITORY_NAME}"
            ).toUpperCase()

            cloneWithDK(
              [
                repo_url: repoUrl,
                dk       : dkName,
                branch   : 'main'
              ]
            ) {

              dir("${env.REPOSITORY_NAME}") {

                env.COMMIT_HASH_APP = sh(
                  script: "git log -n 1 --format='%h'",
                  returnStdout: true
                ).trim()

                sh '''
                  echo "Repository checked out"
                  git status
                '''
              }
            }

            stash(
              name: 'source',
              includes: "${env.REPOSITORY_NAME}/**",
              useDefaultExcludes: false
            )
          }
        }
      }
    }

    /* =========================================================
     * SEMANTIC RELEASE
     * ========================================================= */
    stage('Semantic Release (dry-run)') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'source'

          withAwsSecret([
            secret_id: 'SM-AUT-PLAT-PROD-SAP-BTP-GH-TOKEN',
            type: 'keyvalue'
          ]) {

            dir("${env.REPOSITORY_NAME}") {

              sh '''
                set -e

                echo "================================================="
                echo "Runtime check"
                echo "================================================="

                node -v
                npm -v
                git --version
                cf version || true
                mbt --version || true

                echo "================================================="
                echo "Configure GitHub auth"
                echo "================================================="

                git config --global \
                  url."https://${GITHUB_TOKEN}@github.com/".insteadOf \
                  "https://github.com/"

                echo "================================================="
                echo "Install semantic-release"
                echo "================================================="

                npm install --no-save \
                  semantic-release \
                  @semantic-release/commit-analyzer \
                  @semantic-release/release-notes-generator \
                  @semantic-release/exec \
                  @semantic-release/git

                echo "================================================="
                echo "Run semantic-release"
                echo "================================================="

                npx semantic-release --dry-run > sr.log || true

                cat sr.log

                VERSION=$(
                  grep -Eo \
                  'next release version is [0-9]+\\.[0-9]+\\.[0-9]+' \
                  sr.log | awk '{print $5}' | tail -1
                )

                if [ -z "$VERSION" ]; then
                  echo "ERROR: Unable to detect next version"
                  exit 1
                fi

                echo "VERSION=$VERSION" > version.env

                echo "================================================="
                echo "Next version: $VERSION"
                echo "================================================="
              '''
            }
          }

          stash(
            name: 'version',
            includes: "${env.REPOSITORY_NAME}/version.env",
            useDefaultExcludes: false
          )
        }
      }
    }

    /* =========================================================
     * UPDATE MTA VERSION
     * ========================================================= */
    stage('Update MTA Version') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'source'
          unstash 'version'

          dir("${env.REPOSITORY_NAME}") {

            sh '''
              set -e

              VERSION=$(cat version.env | sed 's/VERSION=//')

              echo "Updating mta.yaml to version $VERSION"

              sed -i \
                "s/^version: .*/version: $VERSION/" \
                mta.yaml

              echo "Updated mta.yaml:"
              cat mta.yaml
            '''
          }

          stash(
            name: 'updated-source',
            includes: "${env.REPOSITORY_NAME}/**",
            useDefaultExcludes: false
          )
        }
      }
    }

    /* =========================================================
     * BUILD MTA
     * ========================================================= */
    stage('Build MTA') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'updated-source'

          dir("${env.REPOSITORY_NAME}") {

            sh '''
              set -e

              echo "================================================="
              echo "Tool versions"
              echo "================================================="

              node -v
              npm -v
              mbt --version

              echo "================================================="
              echo "Clean previous build"
              echo "================================================="

              rm -rf gen mta_archives

              echo "================================================="
              echo "Build MTAR"
              echo "================================================="

              mbt build -p cf -t mta_archives

              echo "================================================="
              echo "Generated MTAR"
              echo "================================================="

              ls -lah mta_archives
            '''
          }

          stash(
            name: 'mtar',
            includes: "${env.REPOSITORY_NAME}/mta_archives/*.mtar",
            useDefaultExcludes: false
          )
        }
      }
    }

    /* =========================================================
     * DEPLOY
     * ========================================================= */
    stage('Deploy') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'updated-source'
          unstash 'mtar'

          withCredentials([
            usernamePassword(
              credentialsId: 'cf-btp-trial',
              usernameVariable: 'CF_USER',
              passwordVariable: 'CF_PASSWORD'
            )
          ]) {

            dir("${env.REPOSITORY_NAME}") {

              sh '''
                set -e

                echo "================================================="
                echo "CF CLI version"
                echo "================================================="

                cf version

                echo "================================================="
                echo "Install MultiApps plugin"
                echo "================================================="

                cf install-plugin -f multiapps || true

                MTAR=$(ls mta_archives/*.mtar | head -n 1)

                echo "================================================="
                echo "Login to SAP BTP"
                echo "================================================="

                cf login \
                  -a "$CF_API" \
                  -u "$CF_USER" \
                  -p "$CF_PASSWORD" \
                  -o "$CF_ORG" \
                  -s "$CF_SPACE"

                echo "================================================="
                echo "Deploy MTAR"
                echo "================================================="

                cf deploy "$MTAR" -f
              '''
            }
          }
        }
      }
    }

    /* =========================================================
     * COMMIT & TAG
     * ========================================================= */
    stage('Commit & Tag') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'gh',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('gh') {

          unstash 'updated-source'
          unstash 'version'

          withCredentials([
            usernamePassword(
              credentialsId: 'github-token',
              usernameVariable: 'GIT_USER',
              passwordVariable: 'GIT_TOKEN'
            )
          ]) {

            dir("${env.REPOSITORY_NAME}") {

              sh '''
                set -e

                VERSION=$(cat version.env | sed 's/VERSION=//')

                echo "================================================="
                echo "Git config"
                echo "================================================="

                git config user.email "ci@jenkins"
                git config user.name "Jenkins CI"

                git remote set-url origin \
                  https://${GIT_USER}:${GIT_TOKEN}@github.com/KPICorporate/${REPOSITORY_NAME}.git

                echo "================================================="
                echo "Sync repository"
                echo "================================================="

                git fetch --all --tags

                git checkout main

                git pull origin main

                echo "================================================="
                echo "Commit release"
                echo "================================================="

                git add mta.yaml

                git commit \
                  -m "chore(release): ${VERSION} [skip ci]" \
                  || true

                echo "================================================="
                echo "Create tag"
                echo "================================================="

                git tag -f "v${VERSION}"

                echo "================================================="
                echo "Push changes"
                echo "================================================="

                git push origin main
                git push origin --tags --force
              '''
            }
          }
        }
      }
    }
  }
}