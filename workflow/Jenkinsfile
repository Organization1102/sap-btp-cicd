pipeline {

  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: sap-btp
    image: node:20-alpine
    command:
      - cat
    tty: true
"""
    }
  }

  options {
    ansiColor('xterm')
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  environment {
    CF_API   = 'https://api.cf.eu10-004.hana.ondemand.com'
    CF_ORG   = 'Kuwait Petroleum Italia S.p.A.'
    CF_SPACE = 'FlexibleV1'

    GH_ORGANIZATION = 'KPICorporate'
    REPOSITORY_NAME = 'sap-btp-cicd'
    JENKINS_ENV = "PROD"
  }

  stages {

    /* ----------------------------------------
     * CHECKOUT
     * ---------------------------------------- */
    stage('Checkout') {
      steps {
        container('sap-btp') {
          script {
            def repoUrl = "git@github.com:${env.GH_ORGANIZATION}/${env.REPOSITORY_NAME}.git"
            def dkName  = ("AUT-PLAT-${env.JENKINS_ENV}-DK-${env.REPOSITORY_NAME}").toUpperCase()

            cloneWithDK(
              repo_url: repoUrl,
              dk: dkName,
              branch: "main"
            )

            dir("${env.REPOSITORY_NAME}") {
              env.COMMIT_HASH_APP = sh(
                script: "git log -n 1 --format='%h'",
                returnStdout: true
              ).trim()
            }
          }
        }
      }
    }

    /* ----------------------------------------
     * BOOTSTRAP TOOLING (ONCE)
     * ---------------------------------------- */
    stage('Bootstrap') {
      steps {
        container('sap-btp') {
          sh '''
            set -e

            echo "Installing OS deps..."
            apk add --no-cache \
              curl git make g++ python3 openjdk21-jre

            echo "Installing Node tools..."
            npm install -g mbt @sap/cds-dk

            echo "Installing CF CLI..."
            curl -L "https://packages.cloudfoundry.org/stable?release=linux64-binary&source=github" -o cf.tgz
            tar -xzf cf.tgz
            mv cf /usr/local/bin/
            chmod +x /usr/local/bin/cf

            cf version
            node -v
            npm -v
            mbt --version
          '''
        }
      }
    }

    /* ----------------------------------------
     * INSTALL SEMANTIC RELEASE
     * ---------------------------------------- */
    stage('Install Semantic Release') {
      steps {
        container('sap-btp') {
          sh '''
            npm install semantic-release \
              @semantic-release/commit-analyzer \
              @semantic-release/release-notes-generator \
              @semantic-release/exec \
              @semantic-release/git
          '''
        }
      }
    }

    /* ----------------------------------------
     * SEMANTIC RELEASE (DRY RUN)
     * ---------------------------------------- */
    stage('Semantic Release') {
      steps {
        container('sap-btp') {
          withAwsSecret([
            secret_id: "SM-AUT-PLAT-PROD-SAP-BTP-GH-TOKEN",
            type: "keyvalue"
          ]) {
            sh '''
              set -e

              echo "Configuring GitHub auth..."
              git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

              echo "Running semantic-release..."
              npm exec semantic-release -- --dry-run > sr.log || true

              VERSION=$(grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' sr.log | tail -1)

              if [ -z "$VERSION" ]; then
                echo "ERROR: Version not found"
                exit 1
              fi

              echo "VERSION=$VERSION" > version.env
              echo "Next version: $VERSION"
            '''
          }
        }
      }
    }

    /* ----------------------------------------
     * UPDATE MTA VERSION
     * ---------------------------------------- */
    stage('Update MTA') {
      steps {
        container('sap-btp') {
          sh '''
            set -e

            VERSION=$(cat version.env | sed 's/VERSION=//')

            cd ${REPOSITORY_NAME}

            echo "Updating mta.yaml to $VERSION"

            sed -i "s/^version: .*/version: $VERSION/" mta.yaml
          '''
        }
      }
    }

    /* ----------------------------------------
     * BUILD MTA
     * ---------------------------------------- */
    stage('Build MTA') {
      steps {
        container('sap-btp') {
          sh '''
            set -e

            cd ${REPOSITORY_NAME}

            rm -rf mta_archives gen

            echo "Building MTAR..."
            mbt build -p cf -t mta_archives
          '''
        }
      }
    }

    /* ----------------------------------------
     * DEPLOY
     * ---------------------------------------- */
    stage('Deploy') {
      steps {
        container('sap-btp') {
          withCredentials([usernamePassword(
            credentialsId: 'cf-btp-trial',
            usernameVariable: 'CF_USER',
            passwordVariable: 'CF_PASSWORD'
          )]) {
            sh '''
              set -e

              cd ${REPOSITORY_NAME}

              cf login \
                -a $CF_API \
                -u $CF_USER \
                -p $CF_PASSWORD \
                -o "$CF_ORG" \
                -s $CF_SPACE

              cf install-plugin -f multiapps

              MTAR=$(ls mta_archives/*.mtar | head -n 1)

              echo "Deploying $MTAR"

              cf deploy $MTAR -f
            '''
          }
        }
      }
    }

    /* ----------------------------------------
     * COMMIT & TAG
     * ---------------------------------------- */
    stage('Commit & Tag') {
      steps {
        container('sap-btp') {
          withCredentials([usernamePassword(
            credentialsId: 'github-token',
            usernameVariable: 'GIT_USER',
            passwordVariable: 'GIT_TOKEN'
          )]) {
            sh '''
              set -e

              VERSION=$(cat version.env | sed 's/VERSION=//')

              cd ${REPOSITORY_NAME}

              git config user.email "ci@jenkins"
              git config user.name "Jenkins CI"

              git remote set-url origin https://${GIT_USER}:${GIT_TOKEN}@github.com/KPICorporate/${REPOSITORY_NAME}.git

              git pull origin main

              git add mta.yaml
              git commit -m "chore(release): $VERSION [skip ci]" || true

              git tag -f "v$VERSION"

              git push origin main
              git push origin --tags
            '''
          }
        }
      }
    }
  }
}