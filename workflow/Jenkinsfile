pipeline {

  agent none

  options {
    ansiColor('xterm')
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  environment {
    CF_API   = 'https://api.cf.eu10-004.hana.ondemand.com'
    CF_ORG   = 'Kuwait Petroleum Italia S.p.A.'
    CF_SPACE = 'FlexibleV1'

    GH_ORGANIZATION = 'KPICorporate'
    REPOSITORY_NAME = 'sap-btp-cicd'
    JENKINS_ENV     = 'PROD'
	
	  NEXUS_URL  = 'https://nexus.automation-platform.eu-west-1.aws.q8int.com'
	  NEXUS_REPO = 'sap-btp-raw-dev-hosted'
  }

  stages {

    /* =========================================================
     * CHECKOUT (GH POD)
     * ========================================================= */
    stage('Checkout') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'gh',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('gh') {

          script {

            def repoUrl = "git@github.com:${env.GH_ORGANIZATION}/${env.REPOSITORY_NAME}.git"

            def dkName = (
              "AUT-PLAT-${env.JENKINS_ENV}-DK-${env.REPOSITORY_NAME}"
            ).toUpperCase()

            cloneWithDK(
              [
                repo_url: repoUrl,
                dk       : dkName,
                branch   : 'main'
              ]
            ) {

              dir("${env.REPOSITORY_NAME}") {

                env.COMMIT_HASH_APP = sh(
                  script: "git log -n 1 --format='%h'",
                  returnStdout: true
                ).trim()

                sh '''
                  echo "Repository checked out"
                  git status
                '''
              }
            }

            stash(
              name: 'source',
              includes: '**',
              useDefaultExcludes: false
            )
          }
        }
      }
    }

stage('Semantic Release (dry-run)') {

  agent {
    kubernetes(k8sAgent(
      cloud: 'kubernetes',
      podTemplate: 'sap-btp',
      serviceAccount: 'jenkins'
    ))
  }

  steps {

    container('sap-btp') {

      unstash 'source'

      withAwsSecret([
        secret_id: "SM-AUT-PLAT-PROD-SAP-BTP-GH-TOKEN".toUpperCase(),
        type: "keyvalue"
      ]) {

        script {

          def githubToken = env.token

          dir("${env.REPOSITORY_NAME}") {

            sh '''
              node -v
              npm -v
            '''

            sh """
              git remote set-url origin \
                https://x-access-token:${githubToken}@github.com/${GH_ORGANIZATION}/${REPOSITORY_NAME}.git
            """

            withEnv([
              "GITHUB_TOKEN=${githubToken}",
              "GH_TOKEN=${githubToken}",
              "GIT_BRANCH=main",
              "BRANCH_NAME=main",
              "CI=true",
              "NO_COLOR=1",
              "FORCE_COLOR=0"
            ]) {

              sh '''
                set -e

                echo "Installing semantic-release..."

                npm install --no-save \
                  semantic-release \
                  @semantic-release/commit-analyzer \
                  @semantic-release/release-notes-generator \
                  @semantic-release/git

                echo "Running semantic-release dry-run..."

                npx semantic-release \
                  --branches main \
                  --dry-run \
                  --no-ci \
                  --plugins \
                    @semantic-release/commit-analyzer \
                    @semantic-release/release-notes-generator \
                    @semantic-release/git \
                  > semantic.log 2>&1 || true

                cat semantic.log

                VERSION=$(grep 'next release version is' semantic.log | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | tail -1)

                [ -z "$VERSION" ] && {
                  echo "Unable to detect semantic-release version"
                  exit 1
                }

                echo "VERSION=$VERSION" > version.env
                echo "Next version: $VERSION"
              '''
            }
          }
        }
      }

      stash(
        name: 'version',
        includes: "${env.REPOSITORY_NAME}/version.env"
      )
    }
  }
}

    /* =========================================================
     * UPDATE MTA VERSION
     * ========================================================= */
    stage('Update MTA Version') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'source'
          unstash 'version'

          dir("${env.REPOSITORY_NAME}") {

            sh '''
              set -e

              VERSION=$(cat version.env | sed 's/VERSION=//')

              echo "Updating mta.yaml to version $VERSION"

              MTA_FILE="workflow/mta.yaml"

              ls -la workflow

              sed -i \
                "s/^version: .*/version: $VERSION/" \
                "$MTA_FILE"

              echo "Updated file:"
              cat "$MTA_FILE"
            '''
          }

          stash(
            name: 'updated-source',
            includes: '**',
            useDefaultExcludes: false
          )
        }
      }
    }

    /* =========================================================
     * BUILD MTA
     * ========================================================= */
    stage('Build MTA') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('sap-btp') {

          unstash 'updated-source'

          dir("${env.REPOSITORY_NAME}/workflow") {

            sh '''
              set -e

              echo "================================================="
              echo "Tool versions"
              echo "================================================="

              node -v
              npm -v
              mbt --version

              echo "================================================="
              echo "Clean previous build"
              echo "================================================="

              rm -rf gen mta_archives

              echo "================================================="
              echo "Build MTAR"
              echo "================================================="

              mbt build -p cf -t mta_archives

              echo "================================================="
              echo "Generated MTAR"
              echo "================================================="

              ls -lah mta_archives
            '''
          }

          stash(
            name: 'mtar',
            includes: "${env.REPOSITORY_NAME}/workflow/mta_archives/*.mtar",
            useDefaultExcludes: false
          )
        }
      }
    }
	
	
	/* =========================================================
	 * PUBLISH MTAR TO NEXUS
     * ========================================================= */
	stage('Publish MTAR to Nexus') {

		agent {
			kubernetes(k8sAgent(
			cloud: 'kubernetes',
			podTemplate: 'sap-btp',
			serviceAccount: 'jenkins'
			))
		}

		steps {

			container('sap-btp') {

			unstash 'mtar'
			unstash 'version'
			
			withAwsSecret([
			  secret_id: "SM-AUT-PLAT-PROD-SAP-BTP-DEPLOY-CREDENTIALS".toUpperCase(),
			  type: "keyvalue"
			]) {
			
			  script {
				
				def nexusToken = env.token

				dir("${env.REPOSITORY_NAME}/workflow") {

					sh """
						set -e
					
					withEnv([
						"NEXUS_TOKEN_B64=${nexusToken}"

					])

					VERSION=$(cat ../version.env | sed 's/VERSION=//')

					MTAR_FILE=$(ls mta_archives/*.mtar | head -n 1)

					MTAR_NAME=$(basename "$MTAR_FILE")

					echo "================================================="
					echo "Upload MTAR to Nexus"
					echo "================================================="

					echo "Artifact: $MTAR_NAME"
					echo "Version : $VERSION"

					HTTP_CODE=$(curl \
					--insecure \
					-H "Authorization: Basic ${NEXUS_TOKEN_B64}" \
					-H "Content-Type: application/octet-stream" \
					--upload-file "$MTAR_FILE" \
					-w "%{http_code}" \
					-o /dev/null \
					"${NEXUS_URL}/repository/${NEXUS_REPO}/${VERSION}/${MTAR_NAME}")

				echo "HTTP CODE: $HTTP_CODE"

				if [ "$HTTP_CODE" != "201" ]; then
					echo "ERROR: Upload failed"
					exit 1
				fi

				echo "Upload completed successfully"
				"""
      }  
     }  
	  }
	 }
  }
 }

    /* =========================================================
     * DEPLOY
     * ========================================================= */
    /* =========================================================
 * DEPLOY
 * ========================================================= */
stage('Deploy') {

  agent {
    kubernetes(k8sAgent(
      cloud: 'kubernetes',
      podTemplate: 'sap-btp',
      serviceAccount: 'jenkins'
    ))
  }

  steps {

    container('sap-btp') {

      unstash 'updated-source'
      unstash 'mtar'

      withAwsSecret([
        secret_id: "SM-AUT-PLAT-PROD-SAP-BTP-DEPLOY-CREDENTIALS".toUpperCase(),
        type: "keyvalue"
      ]) {

        script {

          def btpUser = env.username
          def btpPassword = env.password

          withEnv([
            "CF_USER=${btpUser}",
            "CF_PASSWORD=${btpPassword}"
          ]) {

            dir("${env.REPOSITORY_NAME}/workflow") {

              sh '''
                set -e

                echo "================================================="
                echo "CF CLI version"
                echo "================================================="

                cf version

                echo "================================================="
                echo "Install MultiApps plugin"
                echo "================================================="

                cf install-plugin -f multiapps || true

                MTAR=$(ls mta_archives/*.mtar | head -n 1)

                echo "================================================="
                echo "Login to SAP BTP"
                echo "================================================="

                cf login \
                  -a "$CF_API" \
                  -u "$CF_USER" \
                  -p "$CF_PASSWORD" \
                  -o "$CF_ORG" \
                  -s "$CF_SPACE"

                echo "================================================="
                echo "Deploy MTAR"
                echo "================================================="

                cf deploy "$MTAR" -f
              '''
            }
          }
        }
      }
    }
  }
}

    /* =========================================================
     * COMMIT & TAG
     * ========================================================= */
    stage('Commit & Tag') {

      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'gh',
          serviceAccount: 'jenkins'
        ))
      }

      steps {

        container('gh') {

          unstash 'updated-source'
          unstash 'version'

          withCredentials([
            usernamePassword(
              credentialsId: 'github-token',
              usernameVariable: 'GIT_USER',
              passwordVariable: 'GIT_TOKEN'
            )
          ]) {

            dir("${env.REPOSITORY_NAME}") {

              sh '''
                set -e

                VERSION=$(cat version.env | sed 's/VERSION=//')

                echo "================================================="
                echo "Git config"
                echo "================================================="

                git config user.email "ci@jenkins"
                git config user.name "Jenkins CI"

                git remote set-url origin \
                  https://${GIT_USER}:${GIT_TOKEN}@github.com/KPICorporate/${REPOSITORY_NAME}.git

                echo "================================================="
                echo "Sync repository"
                echo "================================================="

                git fetch --all --tags

                git checkout main

                git pull origin main

                echo "================================================="
                echo "Commit release"
                echo "================================================="

                git add workflow/mta.yaml

                git commit \
                  -m "chore(release): ${VERSION} [skip ci]" \
                  || true

                echo "================================================="
                echo "Create tag"
                echo "================================================="

                git tag -f "v${VERSION}"

                echo "================================================="
                echo "Push changes"
                echo "================================================="

                git push origin main
                git push origin --tags --force
              '''
            }
          }
        }
      }
    }
  }
}