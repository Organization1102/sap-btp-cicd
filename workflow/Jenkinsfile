pipeline {
  agent {
    kubernetes(k8sAgent(
      cloud: 'kubernetes',
      podTemplate: 'gh-sap-btp',   // 👈 deve contenere entrambi i container
      serviceAccount: 'jenkins'
    ))
  }

  options {
    ansiColor('xterm')
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  environment {
    CF_API   = 'https://api.cf.eu10-004.hana.ondemand.com'
    CF_ORG   = 'Kuwait Petroleum Italia S.p.A.'
    CF_SPACE = 'FlexibleV1'

    GH_ORGANIZATION = 'KPICorporate'
    REPOSITORY_NAME = 'sap-btp-cicd'
    JENKINS_ENV     = "PROD"
  }

  stages {

    /* ----------------------------------------
     * CHECKOUT
     * ---------------------------------------- */
    stage('Checkout') {
      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'gh',
          serviceAccount: 'jenkins'
        ))
      }

      environment {
        GH_ORGANIZATION = 'KPICorporate'
        REPOSITORY_NAME = 'sap-btp-cicd'
        JENKINS_ENV = "PROD"
      }

      steps {
        container('gh') {
          script {
            try {

              // Costruzione variabili come da standard piattaforma
              def repoUrl = "git@github.com:${env.GH_ORGANIZATION}/${env.REPOSITORY_NAME}.git"
              def dkName  = ("AUT-PLAT-${env.JENKINS_ENV}-DK-${env.REPOSITORY_NAME}").toUpperCase()

              cloneWithDK(
                repo_url: repoUrl,
                dk: dkName,
                branch: "main"
              ) {
                dir("${env.REPOSITORY_NAME}") {
                  env.COMMIT_HASH_APP = sh(
                    script: "git log -n 1 --format='%h'",
                    returnStdout: true
                  ).trim()
                }
              }

              stash name: "${BUILD_TAG}",
                    includes: "${env.REPOSITORY_NAME}/**",
                    useDefaultExcludes: false

            } catch (Exception e) {
              sh 'exit 400'
              error("Code checkout failed: ${e}")
            }
          }
        }
      }
    }

    /* ----------------------------------------
     * SEMANTIC RELEASE
     * ---------------------------------------- */
    stage('Semantic Release (dry-run)') {
      steps {
        container('sap-btp') {
          unstash "source"

          withAwsSecret([
            secret_id: "SM-AUT-PLAT-PROD-SAP-BTP-GH-TOKEN".toUpperCase(),
            type: "keyvalue"
          ]) {

            dir("${env.REPOSITORY_NAME}") {

              sh '''
                set -e

                export PATH=$WORKSPACE/node20/bin:$PATH

                echo "Configuring Git auth..."
                git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

                echo "Installing dependencies..."
                npm install

                echo "Running semantic-release..."
                npm exec semantic-release -- --dry-run > sr.log || true

                VERSION=$(grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' sr.log | tail -1)

                if [ -z "$VERSION" ]; then
                  echo "No version detected"
                  exit 1
                fi

                echo "VERSION=$VERSION" > version.env
                echo "Next version: $VERSION"
              '''
            }
          }

          stash name: "version",
                includes: "${env.REPOSITORY_NAME}/version.env"
        }
      }
    }

    /* ----------------------------------------
     * UPDATE MTA
     * ---------------------------------------- */
    stage('Update MTA Version') {
      steps {
        container('gh') {
          unstash "source"
          unstash "version"

          dir("${env.REPOSITORY_NAME}") {

            sh '''
              set -e

              VERSION=$(cat version.env | sed 's/VERSION=//')

              echo "Updating MTA to $VERSION"

              sed -i "s/^version: .*/version: $VERSION/" mta.yaml
            '''
          }

          stash name: "updated-source",
                includes: "${env.REPOSITORY_NAME}/**"
        }
      }
    }

    /* ----------------------------------------
     * BUILD MTA
     * ---------------------------------------- */
    stage('Build MTA') {
      steps {
        container('sap-btp') {
          unstash "updated-source"

          dir("${env.REPOSITORY_NAME}") {

            sh '''
              set -e

              mbt --version

              echo "Cleaning..."
              rm -rf mta_archives gen

              echo "Building MTAR..."
              mbt build -p cf -t mta_archives
            '''
          }

          stash name: "mtar",
                includes: "${env.REPOSITORY_NAME}/mta_archives/*.mtar"
        }
      }
    }

    /* ----------------------------------------
     * DEPLOY
     * ---------------------------------------- */
    stage('Deploy') {
      steps {
        container('sap-btp') {
          unstash "updated-source"
          unstash "mtar"

          withCredentials([usernamePassword(
            credentialsId: 'cf-btp-trial',
            usernameVariable: 'CF_USER',
            passwordVariable: 'CF_PASSWORD'
          )]) {

            dir("${env.REPOSITORY_NAME}") {

              sh '''
                set -e

                cf version

                cf install-plugin -f multiapps || true

                MTAR=$(ls mta_archives/*.mtar | head -n 1)

                echo "Logging into BTP..."
                cf login \
                  -a $CF_API \
                  -u $CF_USER \
                  -p $CF_PASSWORD \
                  -o "$CF_ORG" \
                  -s $CF_SPACE

                echo "Deploying $MTAR"
                cf deploy $MTAR -f
              '''
            }
          }
        }
      }
    }

    /* ----------------------------------------
     * COMMIT & TAG
     * ---------------------------------------- */
    stage('Commit & Tag') {
      steps {
        container('gh') {
          unstash "updated-source"
          unstash "version"

          withCredentials([usernamePassword(
            credentialsId: 'github-token',
            usernameVariable: 'GIT_USER',
            passwordVariable: 'GIT_TOKEN'
          )]) {

            dir("${env.REPOSITORY_NAME}") {

              sh '''
                set -e

                VERSION=$(cat version.env | sed 's/VERSION=//')

                git config user.email "ci@jenkins"
                git config user.name "Jenkins CI"

                git remote set-url origin https://$GIT_USER:$GIT_TOKEN@github.com/KPICorporate/sap-btp-cicd.git

                git pull origin main

                git add mta.yaml
                git commit -m "chore(release): $VERSION [skip ci]" || true

                git tag -f "v$VERSION"

                git push origin main
                git push origin --tags
              '''
            }
          }
        }
      }
    }
  }
}