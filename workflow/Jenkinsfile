pipeline {
  agent none

  options {
    ansiColor('xterm')
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  environment {
    CF_API   = 'https://api.cf.eu10-004.hana.ondemand.com'
    CF_ORG   = 'Kuwait Petroleum Italia S.p.A.'
    CF_SPACE = 'FlexibleV1'

    GH_ORGANIZATION = 'KPICorporate'
    REPOSITORY_NAME = 'sap-btp-cicd'
    JENKINS_ENV     = 'PROD'
  }

  stages {

    /* ----------------------------------------
     * CHECKOUT (gh pod)
     * ---------------------------------------- */
    stage('Checkout') {
      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'gh',
          serviceAccount: 'jenkins'
        ))
      }

      steps {
        container('gh') {
          script {
            def repoUrl = "git@github.com:${env.GH_ORGANIZATION}/${env.REPOSITORY_NAME}.git"
            def dkName  = ("AUT-PLAT-${env.JENKINS_ENV}-DK-${env.REPOSITORY_NAME}").toUpperCase()

            cloneWithDK(
              repo_url: repoUrl,
              dk: dkName,
              branch: "main"
            ) {
              dir("${env.REPOSITORY_NAME}") {
                env.COMMIT_HASH_APP = sh(
                  script: "git log -n 1 --format='%h'",
                  returnStdout: true
                ).trim()
              }
            }

            stash name: 'workspace', includes: '**', useDefaultExcludes: false
          }
        }
      }
    }

    /* ----------------------------------------
     * SEMANTIC RELEASE
     * ---------------------------------------- */
    stage('Semantic Release (dry-run)') {
      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {
        container('sap-btp') {
          unstash 'workspace'

          withAwsSecret([
            secret_id: "SM-AUT-PLAT-PROD-SAP-BTP-GH-TOKEN",
            type: "keyvalue"
          ]) {
            sh '''
              set -e

              cd $REPOSITORY_NAME

              git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

              semantic-release --dry-run > sr.log || true

              VERSION=$(grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' sr.log | tail -1)
              [ -z "$VERSION" ] && exit 1

              echo "VERSION=$VERSION" > ../version.env
              echo "Next version: $VERSION"
            '''
          }

          stash name: 'workspace', includes: '**', useDefaultExcludes: false
        }
      }
    }

    /* ----------------------------------------
     * UPDATE MTA
     * ---------------------------------------- */
    stage('Update MTA Version') {
      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {
        container('sap-btp') {
          unstash 'workspace'

          sh '''
            set -e

            VERSION=$(cat version.env | sed 's/VERSION=//')

            cd $REPOSITORY_NAME

            echo "Updating mta.yaml -> $VERSION"

            sed -i "s/^version: .*/version: $VERSION/" mta.yaml
          '''

          stash name: 'workspace', includes: '**', useDefaultExcludes: false
        }
      }
    }

    /* ----------------------------------------
     * BUILD MTA
     * ---------------------------------------- */
    stage('Build MTA') {
      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {
        container('sap-btp') {
          unstash 'workspace'

          sh '''
            set -e

            cd $REPOSITORY_NAME

            echo "Cleaning..."
            rm -rf mta_archives gen

            echo "Building MTAR..."
            mbt build -p cf -t mta_archives

            ls -l mta_archives
          '''

          stash name: 'workspace', includes: '**', useDefaultExcludes: false
        }
      }
    }

    /* ----------------------------------------
     * DEPLOY
     * ---------------------------------------- */
    stage('Deploy') {
      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'sap-btp',
          serviceAccount: 'jenkins'
        ))
      }

      steps {
        container('sap-btp') {
          unstash 'workspace'

          withCredentials([usernamePassword(
            credentialsId: 'cf-btp-trial',
            usernameVariable: 'CF_USER',
            passwordVariable: 'CF_PASSWORD'
          )]) {

            sh '''
              set -e

              cd $REPOSITORY_NAME

              cf login \
                -a "$CF_API" \
                -u "$CF_USER" \
                -p "$CF_PASSWORD" \
                -o "$CF_ORG" \
                -s "$CF_SPACE"

              cf install-plugin multiapps -f

              MTAR=$(ls mta_archives/*.mtar | head -n 1)

              echo "Deploying $MTAR"

              cf deploy $MTAR -f
            '''
          }
        }
      }
    }

    /* ----------------------------------------
     * COMMIT & TAG
     * ---------------------------------------- */
    stage('Commit & Tag') {
      agent {
        kubernetes(k8sAgent(
          cloud: 'kubernetes',
          podTemplate: 'gh',
          serviceAccount: 'jenkins'
        ))
      }

      steps {
        container('gh') {
          unstash 'workspace'

          withCredentials([usernamePassword(
            credentialsId: 'github-token',
            usernameVariable: 'GIT_USER',
            passwordVariable: 'GIT_TOKEN'
          )]) {

            sh '''
              set -e

              VERSION=$(cat version.env | sed 's/VERSION=//')

              cd $REPOSITORY_NAME

              git config user.email "ci@jenkins"
              git config user.name "Jenkins CI"

              git remote set-url origin https://$GIT_USER:$GIT_TOKEN@github.com/$GH_ORGANIZATION/$REPOSITORY_NAME.git

              git fetch origin main
              git checkout main
              git pull origin main

              git add mta.yaml

              git commit -m "chore(release): $VERSION [skip ci]" || echo "No changes"

              git tag -f "v$VERSION"

              git push origin main
              git push origin --tags
            '''
          }
        }
      }
    }
  }
}