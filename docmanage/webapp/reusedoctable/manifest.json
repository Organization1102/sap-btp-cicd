{
    "_version": "1.12.0",
    "sap.app": {
        "id": "com.sap.ecm.reuse.documentTable",
        "type": "component",
        "i18n": "i18n/components.properties",
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "applicationVersion": {
            "version": "1.0.0"
        }
    },
    "sap.cloud": {
        "service": "com.sap.ecm.reuse",
        "public": true
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "com.sap.ecm.reuse.documentTable.view.DocumentView",
            "type": "XML"
        },
        "dependencies": {
            "minUI5Version": "1.60",
            "libs": {
                "sap.ui.layout": {},
                "sap.ui.unified": {},
                "sap.ui.core": {},
                "sap.m": {},
                "sap.uxap": {},
                "sap.ui.comp": {},
                "sap.ushell": {},
                "sap.ui.vk": {}
            }
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "uri": "i18n/components.properties"
            },
            "@i18n": {
                "preload": true,
                "type": "sap.ui.model.resource.ResourceModel",
                "uri": "i18n/components.properties"
            }
        },
        "resources": {
            "css": [
                {
                    "uri": "css/components.css"
                }
            ]
        }
    }
}